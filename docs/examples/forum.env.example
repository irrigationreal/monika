# Copy to runtime/secrets/forum.env before starting the forum.
# Replace every change-me value with a local secret.
#
# This file is loaded into both application containers with Compose `env_file`.
# Values explicitly declared in compose.yaml take precedence and must instead be
# exported in the host shell, placed in the ignored root .env, or set in the
# ignored compose.yaml. That includes CODEX_FORUM_BASE_URL, password/passkey
# policy, WebAuthn RP values, registration mode, and the default model.

# Bootstrap admin created on first forum startup when auth is enabled.
CODEX_FORUM_BOOTSTRAP_ADMIN_USERNAME=admin
CODEX_FORUM_BOOTSTRAP_ADMIN_PASSWORD=change-me-generate-a-long-password
CODEX_FORUM_BOOTSTRAP_ADMIN_DISPLAY_NAME=Admin

# Shared by the forum and Monika container for internal attachment upload APIs.
# Generate a random value, e.g. with:
# python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
CODEX_FORUM_INTERNAL_API_TOKEN=change-me-generate-a-random-token

# Shared by the forum container and host-side deploy automation for quiescence checks.
# Generate separately from CODEX_FORUM_INTERNAL_API_TOKEN.
CODEX_FORUM_DEPLOY_TOKEN=change-me-generate-a-different-random-token

# Background Pi session sync is enabled by default. Set to 0 only for debugging.
# MONIKA_PI_SYNC_ENABLED=0
# MONIKA_PI_SYNC_INTERVAL_MS=5000

# Optional custom Pi import/sync taxonomy uses Compose interpolation and therefore
# does NOT belong in this env_file. Set MONIKA_PI_SESSION_TAXONOMY_CONFIG through
# the host shell, ignored root .env, or ignored compose.yaml after copying
# docs/examples/forum-taxonomy.example.json to runtime/forum/taxonomy.local.json.
