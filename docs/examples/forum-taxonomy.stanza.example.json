{
  "version": 1,
  "defaults": {
    "target": { "name": "General" },
    "cwd": "/home/monika",
    "homeCwds": ["/home/monika"]
  },
  "system": {
    "parent": "System",
    "cwd": "/home/monika",
    "sleep": { "name": "Sleep" },
    "delegate": { "name": "Delegates" },
    "fork": { "name": "Forks" }
  },
  "rules": [
    {
      "target": { "name": "The Zeta Directive" },
      "cwd": "/home/monika/repos/TheZetaDirective",
      "cwdPrefixes": ["/home/monika/repos/TheZetaDirective"]
    },
    {
      "target": { "name": "Monika Runtime" },
      "cwd": "/home/monika/repos/monika",
      "cwdPrefixes": [
        "/home/monika/repos/monika",
        "/home/monika/repos/monika-mono",
        "/home/monika/repos/memory",
        "/home/monika/repos/monika-aroz",
        "/home/monika/repos/monika-voice",
        "/persist/monika-core",
        "/home/monika/.pi"
      ],
      "homeKeywords": [
        ".pi",
        "pi upgrade",
        "pi config",
        "pi system prompt",
        "model config",
        "models.json",
        "extension",
        "handoff",
        "stateful-memory",
        "memory system",
        "memory upgrade",
        "memstore",
        "neotoma",
        "tagmem",
        "wake.md",
        "facts.md",
        "sleep cycle",
        "agent browser",
        "monika container",
        "container runtime",
        "codex forum",
        "agentd"
      ]
    },
    {
      "target": { "name": "Codex Forum" },
      "cwd": "/home/monika/repos/monika-forum",
      "cwdPrefixes": [
        "/home/monika/repos/monika-forum",
        "/home/monika/repos/forum-echs"
      ]
    },
    {
      "target": { "name": "Shadowsea" },
      "cwd": "/persist/shadowsea",
      "cwdPrefixes": ["/persist/shadowsea", "/home/monika/repos/shadowsea"]
    },
    {
      "target": { "name": "Vesper" },
      "cwd": "/home/monika/repos/vesper",
      "cwdPrefixes": ["/home/monika/repos/vesper"]
    },
    {
      "target": { "name": "OpenStarbound" },
      "cwd": "/home/monika/repos/OpenStarbound",
      "cwdPrefixes": ["/home/monika/repos/OpenStarbound"]
    },
    {
      "target": { "name": "neosynth-arise" },
      "cwd": "/home/monika/repos/neosynth-arise",
      "cwdPrefixes": ["/home/monika/repos/neosynth-arise"]
    }
  ]
}
