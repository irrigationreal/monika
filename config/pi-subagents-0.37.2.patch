diff --git a/test/unit/execution-target.test.ts b/test/unit/execution-target.test.ts
new file mode 100644
index 0000000..2341f60
--- /dev/null
+++ b/test/unit/execution-target.test.ts
@@ -0,0 +1,99 @@
+import assert from "node:assert/strict";
+import { mkdtempSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import path from "node:path";
+import { describe, it } from "node:test";
+import { launchBindingDigest } from "../../src/shared/launch-contract.ts";
+import {
+  assertExecutionTargetAsyncCompatible,
+  assertExecutionTargetWorktreeCompatible,
+  parseLockedSshDescriptor,
+  executionTargetBindingDigest,
+  executionTargetChildLaunch,
+  resolveEffectsEvidenceState,
+  resolveExecutionTarget,
+  validateExecutionTarget,
+} from "../../src/runs/shared/execution-target.ts";
+
+const descriptor = {
+  version: 1,
+  name: "stanza",
+  target: "deploy@stanza",
+  hostname: "stanza",
+  cwd: "/home/monika/repos/monika",
+  allowedRoot: "/home/monika/repos",
+  knownHosts: "/runtime/secrets/ssh/known_hosts",
+};
+
+describe("execution targets", () => {
+  it("defaults locally and validates the closed public shape", () => {
+    assert.deepEqual(resolveExecutionTarget(undefined, {}).public, { kind: "local" });
+    assert.deepEqual(validateExecutionTarget({ kind: "ssh", name: "stanza" }), { kind: "ssh", name: "stanza" });
+    assert.throws(() => validateExecutionTarget({ kind: "ssh", name: "../stanza" }), /executionTarget/);
+    assert.throws(() => validateExecutionTarget({ kind: "local", name: "stanza" }), /extra fields/);
+    assert.throws(() => validateExecutionTarget({ kind: "ssh", name: "stanza", host: "evil" }), /extra fields/);
+  });
+
+  it("never infers relocation metadata when executionTarget is omitted", () => {
+    assert.deepEqual(resolveExecutionTarget(undefined, {
+      PI_SUBAGENT_EXECUTION_TARGET_NAME: "stanza",
+      PI_SUBAGENT_EXECUTION_TARGET_DIGEST: "a".repeat(64),
+    }).public, { kind: "local" });
+    assert.deepEqual(executionTargetChildLaunch({ kind: "local", public: { kind: "local" } }).env, {
+      MONIKA_SSH_LOCK_DESCRIPTOR: undefined,
+      PI_SUBAGENT_EXECUTION_TARGET_NAME: "local",
+      PI_SUBAGENT_EXECUTION_TARGET_DIGEST: undefined,
+      PI_SUBAGENT_EFFECTS_EVIDENCE_PATH: undefined,
+    });
+    assert.throws(() => resolveExecutionTarget(undefined, {
+      MONIKA_SSH_LOCK_DESCRIPTOR: "/definitely/missing/locked-target.json",
+    }), /locked SSH extension|ENOENT|no such file/i, "a locked ambient process cannot downgrade its local default or fall back");
+  });
+
+  it("binds descriptor, known_hosts, and lock code into target recovery identity", () => {
+    const raw = Buffer.from(JSON.stringify(descriptor));
+    const first = executionTargetBindingDigest(raw, Buffer.from("host-a"), "a".repeat(64));
+    assert.notEqual(first, executionTargetBindingDigest(raw, Buffer.from("host-b"), "a".repeat(64)));
+    assert.notEqual(first, executionTargetBindingDigest(raw, Buffer.from("host-a"), "b".repeat(64)));
+  });
+
+  it("binds public target identity and descriptor digest into launch recovery identity", () => {
+    const common = { definitionDigest: "d".repeat(64), task: "inspect" };
+    const local = launchBindingDigest({ ...common, executionTarget: { kind: "local" } });
+    const remoteA = launchBindingDigest({ ...common, executionTarget: { kind: "ssh", name: "stanza" }, executionTargetDigest: "a".repeat(64) });
+    const remoteB = launchBindingDigest({ ...common, executionTarget: { kind: "ssh", name: "stanza" }, executionTargetDigest: "b".repeat(64) });
+    assert.notEqual(local, remoteA);
+    assert.notEqual(remoteA, remoteB);
+  });
+
+  it("parses strict descriptors and rejects path escapes", () => {
+    assert.deepEqual(parseLockedSshDescriptor(JSON.stringify(descriptor), "stanza"), descriptor);
+    assert.throws(() => parseLockedSshDescriptor(JSON.stringify({ ...descriptor, cwd: "/etc" })), /outside allowedRoot/);
+    assert.throws(() => parseLockedSshDescriptor(JSON.stringify({ ...descriptor, target: "host;touch" })), /target/);
+    assert.throws(() => parseLockedSshDescriptor(JSON.stringify({ ...descriptor, extra: true })), /unknown or missing/);
+  });
+
+  it("treats missing, malformed, ambiguous, and unmatched remote effects evidence as unknown", () => {
+    const dir = mkdtempSync(path.join(tmpdir(), "execution-effects-"));
+    const evidence = path.join(dir, "effects.jsonl");
+    const remote = { kind: "ssh", public: { kind: "ssh", name: "stanza" } } as any;
+    assert.equal(resolveEffectsEvidenceState(remote, evidence), "unknown");
+    writeFileSync(evidence, `${JSON.stringify({ phase: "intent", id: "one" })}\n`);
+    assert.equal(resolveEffectsEvidenceState(remote, evidence), "unknown");
+    writeFileSync(evidence, `${JSON.stringify({ phase: "intent", id: "one" })}\n${JSON.stringify({ phase: "settled", id: "one", effects_state: "confirmed" })}\n`);
+    assert.equal(resolveEffectsEvidenceState(remote, evidence), "confirmed");
+    writeFileSync(evidence, `${JSON.stringify({ phase: "settled", id: "one", effects_state: "unknown" })}\n`);
+    assert.equal(resolveEffectsEvidenceState(remote, evidence), "unknown");
+  });
+
+  it("requires durable async lifecycle for SSH targets", () => {
+    assert.throws(() => assertExecutionTargetAsyncCompatible([{ kind: "ssh", name: "stanza" }], false), /require async:true/);
+    assert.doesNotThrow(() => assertExecutionTargetAsyncCompatible([{ kind: "ssh", name: "stanza" }], true));
+    assert.doesNotThrow(() => assertExecutionTargetAsyncCompatible([{ kind: "local" }], false));
+  });
+
+  it("rejects SSH worktrees before setup", () => {
+    assert.throws(() => assertExecutionTargetWorktreeCompatible([{ kind: "ssh", name: "stanza" }], true), /not supported/);
+    assert.doesNotThrow(() => assertExecutionTargetWorktreeCompatible([{ kind: "local" }], true));
+  });
+});
