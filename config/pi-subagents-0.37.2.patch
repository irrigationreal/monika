+		if (!path.isAbsolute(ambientPath)) throw new Error(`${SSH_LOCK_DESCRIPTOR_ENV} must be absolute.`);
+		const lock = lockExtension(env);
+		const ambient = descriptorFromPath(ambientPath, lock.codeDigest);
+		// Omission is always the local default. Locked parents must explicitly name
+		// their same target; there is no implicit relocation inheritance form.
+		if (!requested || requested.kind === "local" || (requested.kind === "ssh" && requested.name !== ambient.descriptor.name)) {
