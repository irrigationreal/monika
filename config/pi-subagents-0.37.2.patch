diff --git a/test/unit/result-claim.test.ts b/test/unit/result-claim.test.ts
new file mode 100644
index 0000000..39578f0
--- /dev/null
+++ b/test/unit/result-claim.test.ts
@@ -0,0 +1,79 @@
+import assert from "node:assert/strict";
+import * as fs from "node:fs";
+import * as os from "node:os";
+import * as path from "node:path";
+import { describe, it } from "node:test";
+import { claimAwaitedResult } from "../../src/runs/background/result-claim.ts";
+
+function fixture(root: string, runId: string, disposition: "awaited" | "follow_up" | "silent" = "awaited", nestedRoot?: string) {
+	const asyncDir = nestedRoot
+		? path.join(root, "nested-subagent-runs", nestedRoot, runId)
+		: path.join(root, "async-subagent-runs", runId);
+	const resultPath = nestedRoot
+		? path.join(root, "async-subagent-results", "nested", nestedRoot, `${runId}.json`)
+		: path.join(root, "async-subagent-results", `${runId}.json`);
+	fs.mkdirSync(asyncDir, { recursive: true });
+	fs.mkdirSync(path.dirname(resultPath), { recursive: true });
+	const common = { lifecycleArtifactVersion: 5, runId, sessionId: "session-1", deliveryDisposition: disposition };
+	fs.writeFileSync(path.join(asyncDir, "launch.json"), JSON.stringify({ ...common, asyncDir }));
+	fs.writeFileSync(path.join(asyncDir, "status.json"), JSON.stringify({ ...common, mode: "single", state: "complete", startedAt: 1 }));
+	const result = { ...common, id: runId, asyncDir, success: true, summary: `exact:${nestedRoot ?? "top"}:${runId}` };
+	fs.writeFileSync(resultPath, JSON.stringify(result));
+	return { asyncDir, resultPath, result };
+}
+
+describe("awaited result claims", () => {
+	it("publishes an exact identity/digest-bound claim and retries idempotently", () => {
+		const root = fs.mkdtempSync(path.join(os.tmpdir(), "pi-result-claim-"));
+		try {
+			const run = fixture(root, "run-a");
+			const first = claimAwaitedResult({ asyncDir: run.asyncDir, runId: "run-a", sessionId: "session-1", now: () => 10 });
+			assert.equal(first.kind, "claimed");
+			if (first.kind !== "claimed") return;
+			assert.equal(first.claim.runKey, "top:run-a");
+			assert.equal(first.claim.resultSizeBytes, fs.statSync(run.resultPath).size);
+			assert.equal(first.result.summary, "exact:top:run-a");
+			const retry = claimAwaitedResult({ asyncDir: run.asyncDir, runId: "run-a", sessionId: "session-1", now: () => 99 });
+			assert.equal(retry.kind, "claimed");
+			if (retry.kind === "claimed") {
+				assert.equal(retry.idempotent, true);
+				assert.deepEqual(retry.claim, first.claim);
+			}
+		} finally { fs.rmSync(root, { recursive: true, force: true }); }
+	});
+
+	it("fails closed for swapped bytes, malformed claims, and symlinked result files", () => {
+		const root = fs.mkdtempSync(path.join(os.tmpdir(), "pi-result-claim-conflict-"));
+		try {
+			const run = fixture(root, "run-b");
+			claimAwaitedResult({ asyncDir: run.asyncDir, sessionId: "session-1" });
+			fs.writeFileSync(run.resultPath, JSON.stringify({ ...run.result, summary: "swapped" }));
+			assert.throws(() => claimAwaitedResult({ asyncDir: run.asyncDir, sessionId: "session-1" }), /Conflicting result claim/);
+			fs.writeFileSync(path.join(run.asyncDir, "result-claim.json"), "not-json");
+			assert.throws(() => claimAwaitedResult({ asyncDir: run.asyncDir, sessionId: "session-1" }), /Malformed result claim/);
+			fs.rmSync(path.join(run.asyncDir, "result-claim.json"));
+			fs.rmSync(run.resultPath);
+			const outside = path.join(root, "outside.json");
+			fs.writeFileSync(outside, JSON.stringify(run.result));
+			fs.symlinkSync(outside, run.resultPath);
+			assert.throws(() => claimAwaitedResult({ asyncDir: run.asyncDir, sessionId: "session-1" }), /ELOOP|symbolic link|unsafe/i);
+		} finally { fs.rmSync(root, { recursive: true, force: true }); }
+	});
+
+	it("scopes nested keys and never claims follow_up or silent results", () => {
+		const root = fs.mkdtempSync(path.join(os.tmpdir(), "pi-result-claim-nested-"));
+		try {
+			const left = fixture(root, "same", "awaited", "root-left");
+			const right = fixture(root, "same", "awaited", "root-right");
+			const leftClaim = claimAwaitedResult({ asyncDir: left.asyncDir, sessionId: "session-1" });
+			const rightClaim = claimAwaitedResult({ asyncDir: right.asyncDir, sessionId: "session-1" });
+			assert.equal(leftClaim.kind === "claimed" ? leftClaim.claim.runKey : "", "nested:root-left:same");
+			assert.equal(rightClaim.kind === "claimed" ? rightClaim.claim.runKey : "", "nested:root-right:same");
+			for (const disposition of ["follow_up", "silent"] as const) {
+				const run = fixture(root, `run-${disposition}`, disposition);
+				assert.deepEqual(claimAwaitedResult({ asyncDir: run.asyncDir, sessionId: "session-1" }), { kind: "not-claimable", deliveryDisposition: disposition });
+				assert.equal(fs.existsSync(path.join(run.asyncDir, "result-claim.json")), false);
+			}
+		} finally { fs.rmSync(root, { recursive: true, force: true }); }
+	});
+});
