index 0000000..1790b52
--- /dev/null
+++ b/src/runs/shared/execution-target.ts
@@ -0,0 +1,213 @@
+import { createHash } from "node:crypto";
+import * as fs from "node:fs";
+import * as path from "node:path";
+
+export const EXECUTION_TARGET_ROOT_ENV = "PI_SUBAGENT_EXECUTION_TARGET_ROOT";
+export const SSH_LOCK_EXTENSION_ENV = "PI_SUBAGENT_SSH_LOCK_EXTENSION";
+export const SSH_LOCK_CODE_DIGEST_ENV = "PI_SUBAGENT_SSH_LOCK_CODE_DIGEST";
+export const SSH_LOCK_DESCRIPTOR_ENV = "MONIKA_SSH_LOCK_DESCRIPTOR";
+export const EXECUTION_TARGET_NAME_ENV = "PI_SUBAGENT_EXECUTION_TARGET_NAME";
+export const EXECUTION_TARGET_DIGEST_ENV = "PI_SUBAGENT_EXECUTION_TARGET_DIGEST";
+export const EFFECTS_EVIDENCE_PATH_ENV = "PI_SUBAGENT_EFFECTS_EVIDENCE_PATH";
+
+export type ExecutionTarget = { kind: "local" } | { kind: "ssh"; name: string };
+export type PublicExecutionTarget = ExecutionTarget;
+
+export interface LockedSshDescriptor {
+	version: 1;
+	name: string;
+	target: string;
+	hostname: string;
+	cwd: string;
+	allowedRoot: string;
+	knownHosts: string;
+}
+
+export type ResolvedExecutionTarget =
+	| { kind: "local"; public: { kind: "local" } }
+	| {
+		kind: "ssh";
+		name: string;
+		public: { kind: "ssh"; name: string };
+		descriptorPath: string;
+		descriptorDigest: string;
+		descriptor: LockedSshDescriptor;
+		lockExtensionPath: string;
+		lockCodeDigest: string;
+	};
+
+const SAFE_NAME = /^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$/;
+const SAFE_TARGET = /^(?:[A-Za-z0-9._-]+@)?[A-Za-z0-9][A-Za-z0-9._-]*$/;
+const DESCRIPTOR_KEYS = ["allowedRoot", "cwd", "hostname", "knownHosts", "name", "target", "version"].sort();
+const SECRET_ROOT = "/runtime/secrets/ssh";
+
+function plainObject(value: unknown): value is Record<string, unknown> {
+	return Boolean(value) && typeof value === "object" && !Array.isArray(value) && Object.getPrototypeOf(value) === Object.prototype;
+}
+
+function noControls(value: string): boolean {
+	return !/[\u0000-\u001f\u007f]/.test(value);
+}
+
+function canonicalContained(root: string, candidate: string): boolean {
+	const relative = path.relative(root, candidate);
+	return relative === "" || (!relative.startsWith(`..${path.sep}`) && relative !== ".." && !path.isAbsolute(relative));
+}
+
+function requireAbsoluteClean(field: string, value: unknown): string {
+	if (typeof value !== "string" || !path.posix.isAbsolute(value) || !noControls(value) || value.includes("\\")) {
+		throw new Error(`Invalid SSH target descriptor field '${field}': expected an absolute POSIX path.`);
+	}
+	const normalized = path.posix.normalize(value);
+	if (normalized !== value || value.split("/").includes("..")) {
+		throw new Error(`Invalid SSH target descriptor field '${field}': path must be canonical.`);
+	}
+	return value;
+}
+
+export function validateExecutionTarget(value: unknown, field = "executionTarget"): ExecutionTarget | undefined {
+	if (value === undefined) return undefined;
+	if (!plainObject(value)) throw new Error(`${field} must be {kind:'local'} or {kind:'ssh',name:'<configured-name>'}.`);
+	const keys = Object.keys(value).sort();
+	if (value.kind === "local" && keys.length === 1 && keys[0] === "kind") return { kind: "local" };
+	if (value.kind === "ssh" && keys.length === 2 && keys[0] === "kind" && keys[1] === "name" && typeof value.name === "string" && SAFE_NAME.test(value.name)) {
+		return { kind: "ssh", name: value.name };
+	}
+	throw new Error(`${field} must be {kind:'local'} or {kind:'ssh',name:'<safe configured name>'}; extra fields and host options are not allowed.`);
+}
+
+export function parseLockedSshDescriptor(raw: string | Buffer, expectedName?: string): LockedSshDescriptor {
+	let value: unknown;
+	try { value = JSON.parse(raw.toString()); } catch { throw new Error("Invalid SSH target descriptor: malformed JSON."); }
+	if (!plainObject(value) || JSON.stringify(Object.keys(value).sort()) !== JSON.stringify(DESCRIPTOR_KEYS)) {
+		throw new Error("Invalid SSH target descriptor: unknown or missing fields.");
+	}
+	if (value.version !== 1) throw new Error("Invalid SSH target descriptor: unsupported version.");
+	if (typeof value.name !== "string" || !SAFE_NAME.test(value.name) || (expectedName && value.name !== expectedName)) {
+		throw new Error("Invalid SSH target descriptor: name does not match its registry entry.");
+	}
+	for (const field of ["target", "hostname"] as const) {
+		if (typeof value[field] !== "string" || !noControls(value[field] as string) || !(value[field] as string).trim()) {
+			throw new Error(`Invalid SSH target descriptor field '${field}'.`);
+		}
+	}
+	if (!SAFE_TARGET.test(value.target as string)) throw new Error("Invalid SSH target descriptor field 'target'.");
+	if (!/^[A-Za-z0-9][A-Za-z0-9._-]*$/.test(value.hostname as string)) throw new Error("Invalid SSH target descriptor field 'hostname'.");
+	const cwd = requireAbsoluteClean("cwd", value.cwd);
+	const allowedRoot = requireAbsoluteClean("allowedRoot", value.allowedRoot);
+	if (!canonicalContained(allowedRoot, cwd)) throw new Error("Invalid SSH target descriptor: cwd is outside allowedRoot.");
+	const knownHosts = requireAbsoluteClean("knownHosts", value.knownHosts);
+	if (!canonicalContained(SECRET_ROOT, knownHosts)) throw new Error(`Invalid SSH target descriptor: knownHosts must be beneath ${SECRET_ROOT}.`);
+	return { version: 1, name: value.name as string, target: value.target as string, hostname: value.hostname as string, cwd, allowedRoot, knownHosts };
+}
+
+function sha256(value: string | Buffer): string {
+	return createHash("sha256").update(value).digest("hex");
+}
+
+export function executionTargetBindingDigest(descriptorBytes: Buffer, knownHostsBytes: Buffer, lockCodeDigest: string): string {
+	return sha256(JSON.stringify({ descriptor: sha256(descriptorBytes), knownHosts: sha256(knownHostsBytes), lockCode: lockCodeDigest }));
+}
+
+function descriptorFromPath(descriptorPath: string, lockCodeDigest: string, expectedName?: string): { descriptor: LockedSshDescriptor; digest: string; canonicalPath: string } {
+	const lst = fs.lstatSync(descriptorPath);
+	if (!lst.isFile() || lst.isSymbolicLink() || (lst.mode & 0o222) !== 0) throw new Error("SSH target descriptor must be a read-only regular, non-symlink file.");
+	const raw = fs.readFileSync(descriptorPath);
+	const descriptor = parseLockedSshDescriptor(raw, expectedName);
+	const kh = fs.lstatSync(descriptor.knownHosts);
+	if (!kh.isFile() || kh.isSymbolicLink() || (kh.mode & 0o222) !== 0) throw new Error("SSH target knownHosts must be a non-writable regular file.");
+	const knownHosts = fs.readFileSync(descriptor.knownHosts);
+	return { descriptor, digest: executionTargetBindingDigest(raw, knownHosts, lockCodeDigest), canonicalPath: fs.realpathSync(descriptorPath) };
+}
+
+function registryDescriptor(name: string, env: NodeJS.ProcessEnv): string {
+	const rootValue = env[EXECUTION_TARGET_ROOT_ENV]?.trim();
+	if (!rootValue || !path.isAbsolute(rootValue)) throw new Error(`${EXECUTION_TARGET_ROOT_ENV} must be an absolute administrator-owned directory.`);
+	const root = fs.realpathSync(rootValue);
+	const candidate = path.join(root, `${name}.json`);
+	const canonical = fs.realpathSync(candidate);
+	if (!canonicalContained(root, canonical)) throw new Error(`SSH execution target '${name}' escapes the configured registry root.`);
+	return canonical;
+}
+
+function lockExtension(env: NodeJS.ProcessEnv): { path: string; codeDigest: string } {
+	const configured = env[SSH_LOCK_EXTENSION_ENV]?.trim();
+	if (!configured || !path.isAbsolute(configured)) throw new Error(`${SSH_LOCK_EXTENSION_ENV} must name the locked SSH extension.`);
+	const canonical = fs.realpathSync(configured);
+	const helper = path.join(path.dirname(canonical), "ssh-lock.mjs");
+	for (const [label, file] of [["extension", canonical], ["helper", helper]] as const) {
+		const stat = fs.lstatSync(file);
+		if (!stat.isFile() || stat.isSymbolicLink()) throw new Error(`Locked SSH ${label} is not a regular file.`);
+		fs.accessSync(file, fs.constants.R_OK);
+	}
+	const codeDigest = sha256(`${sha256(fs.readFileSync(canonical))}\n${sha256(fs.readFileSync(helper))}\n`);
+	const expected = env[SSH_LOCK_CODE_DIGEST_ENV]?.trim();
+	if (!expected || !/^[a-f0-9]{64}$/.test(expected) || expected !== codeDigest) throw new Error("Locked SSH extension code does not match the startup integrity attestation.");
+	return { path: canonical, codeDigest };
+}
+
+export function resolveExecutionTarget(requestedValue: unknown, env: NodeJS.ProcessEnv = process.env): ResolvedExecutionTarget {
+	const requested = validateExecutionTarget(requestedValue);
+	const ambientPath = env[SSH_LOCK_DESCRIPTOR_ENV]?.trim();
+	if (ambientPath) {
+		if (!path.isAbsolute(ambientPath)) throw new Error(`${SSH_LOCK_DESCRIPTOR_ENV} must be absolute.`);
+		const lock = lockExtension(env);
+		const ambient = descriptorFromPath(ambientPath, lock.codeDigest);
+		// Omission is always the local default. Locked parents must explicitly name
+		// their same target; there is no implicit relocation inheritance form.
+		if (!requested || requested.kind === "local" || (requested.kind === "ssh" && requested.name !== ambient.descriptor.name)) {
+			throw new Error(`Locked SSH parent '${ambient.descriptor.name}' must explicitly reuse its same execution target; local/default or target switching is refused.`);
+		}
+		const expectedDigest = env[EXECUTION_TARGET_DIGEST_ENV]?.trim();
+		if (!expectedDigest || !/^[a-f0-9]{64}$/.test(expectedDigest) || expectedDigest !== ambient.digest) throw new Error("Locked SSH target binding changed or is missing; automatic child launch is refused.");
+		return { kind: "ssh", name: ambient.descriptor.name, public: { kind: "ssh", name: ambient.descriptor.name }, descriptorPath: ambient.canonicalPath, descriptorDigest: ambient.digest, descriptor: ambient.descriptor, lockExtensionPath: lock.path, lockCodeDigest: lock.codeDigest };
+	}
+	if (!requested || requested.kind === "local") return { kind: "local", public: { kind: "local" } };
+	const descriptorPath = registryDescriptor(requested.name, env);
+	const lock = lockExtension(env);
+	const resolved = descriptorFromPath(descriptorPath, lock.codeDigest, requested.name);
+	return { kind: "ssh", name: requested.name, public: { kind: "ssh", name: requested.name }, descriptorPath: resolved.canonicalPath, descriptorDigest: resolved.digest, descriptor: resolved.descriptor, lockExtensionPath: lock.path, lockCodeDigest: lock.codeDigest };
+}
+
+export function executionTargetChildLaunch(target: ResolvedExecutionTarget, effectsEvidencePath?: string): { extensions: string[]; env: Record<string, string | undefined> } {
+	if (target.kind === "local") {
+		return { extensions: [], env: { [SSH_LOCK_DESCRIPTOR_ENV]: undefined, [EXECUTION_TARGET_NAME_ENV]: "local", [EXECUTION_TARGET_DIGEST_ENV]: undefined, [EFFECTS_EVIDENCE_PATH_ENV]: undefined } };
+	}
+	return {
+		extensions: [target.lockExtensionPath],
+		env: {
+			[SSH_LOCK_DESCRIPTOR_ENV]: target.descriptorPath,
+			[SSH_LOCK_CODE_DIGEST_ENV]: target.lockCodeDigest,
+			[EXECUTION_TARGET_NAME_ENV]: target.name,
+			[EXECUTION_TARGET_DIGEST_ENV]: target.descriptorDigest,
+			[EFFECTS_EVIDENCE_PATH_ENV]: effectsEvidencePath,
+		},
+	};
+}
+
+export function resolveEffectsEvidenceState(target: ResolvedExecutionTarget | undefined, evidencePath: string | undefined): "none" | "confirmed" | "unknown" {
+	if (!target || target.kind === "local") return "none";
+	if (!evidencePath) return "unknown";
+	try {
+		const records = fs.readFileSync(evidencePath, "utf-8").split("\n").filter(Boolean).map((line) => JSON.parse(line) as { id?: unknown; phase?: unknown; effects_state?: unknown });
+		const intents = new Set(records.filter((record) => record.phase === "intent" && typeof record.id === "string").map((record) => record.id as string));
+		const settled = new Set(records.filter((record) => record.phase === "settled" && typeof record.id === "string" && record.effects_state === "confirmed").map((record) => record.id as string));
+		if (records.some((record) => record.effects_state === "unknown") || [...intents].some((id) => !settled.has(id))) return "unknown";
+		return intents.size > 0 ? "confirmed" : "none";
+	} catch {
+		// Missing, truncated, or malformed evidence cannot prove that a remote
+		// operation had no effects.
+		return "unknown";
+	}
+}
+
+export function assertExecutionTargetAsyncCompatible(targets: Array<ExecutionTarget | ResolvedExecutionTarget | undefined>, async: boolean): void {
+	if (!async && targets.some((target) => target?.kind === "ssh")) {
+		throw new Error("SSH execution targets require async:true so uncertain remote effects have a durable lifecycle ledger.");
+	}
+}
+
+export function assertExecutionTargetWorktreeCompatible(targets: Array<ExecutionTarget | ResolvedExecutionTarget | undefined>, worktree: boolean | undefined): void {
+	if (!worktree) return;
+	if (targets.some((target) => target?.kind === "ssh")) throw new Error("worktree:true is not supported for SSH execution targets; no worktree was created.");
+}
