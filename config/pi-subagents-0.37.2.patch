+		}
+		const expectedDigest = env[EXECUTION_TARGET_DIGEST_ENV]?.trim();
+		if (!expectedDigest || !/^[a-f0-9]{64}$/.test(expectedDigest) || expectedDigest !== ambient.digest) throw new Error("Locked SSH target binding changed or is missing; automatic child launch is refused.");
