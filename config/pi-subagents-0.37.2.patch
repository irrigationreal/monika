diff --git a/test/support/isolated-test-runner.mjs b/test/support/isolated-test-runner.mjs
new file mode 100644
index 0000000..81a9265
--- /dev/null
+++ b/test/support/isolated-test-runner.mjs
@@ -0,0 +1,38 @@
+import { mkdirSync, mkdtempSync, readdirSync, rmSync } from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { spawnSync } from "node:child_process";
+
+const suite = process.argv[2];
+if (!new Set(["unit", "integration", "e2e"]).has(suite)) throw new Error("expected unit, integration, or e2e suite");
+const root = mkdtempSync(path.join(os.tmpdir(), "pi-subagents-test-"));
+const dir = path.join("test", suite);
+for (const child of ["home", "tmp", "runtime", "sessions", "operator"]) mkdirSync(path.join(root, child));
+const requested = process.argv.slice(3);
+const names = requested.length > 0 ? requested : readdirSync(dir).filter((name) => name.endsWith(".test.ts")).sort();
+for (const name of names) {
+	if (path.basename(name) !== name || !name.endsWith(".test.ts")) throw new Error(`invalid isolated test filename: ${name}`);
+}
+const available = new Set(readdirSync(dir).filter((name) => name.endsWith(".test.ts")));
+for (const name of names) if (!available.has(name)) throw new Error(`isolated test file not found in ${dir}: ${name}`);
+const files = names.map((name) => path.join(dir, name));
+const loader = suite === "unit" ? [] : ["--import", "./test/support/register-loader.mjs"];
+try {
+	const result = spawnSync(process.execPath, ["--experimental-strip-types", ...loader, "--test", ...files], {
+		stdio: "inherit",
+		env: {
+			PATH: process.env.PATH,
+			HOME: path.join(root, "home"),
+			TMPDIR: path.join(root, "tmp"),
+			XDG_CONFIG_HOME: path.join(root, "home", ".config"),
+			PI_SUBAGENT_RUNTIME_ROOT: path.join(root, "runtime"),
+			PI_SUBAGENT_SESSION_ROOT: path.join(root, "sessions"),
+			PI_SUBAGENT_OPERATOR_ROOT: path.join(root, "operator"),
+			MONIKA_RUNTIME_INSTANCE_FILE: path.join(root, "runtime-instance.json"),
+		},
+	});
+	if (result.error) throw result.error;
+	process.exitCode = result.status ?? 1;
+} finally {
+	rmSync(root, { recursive: true, force: true });
+}
