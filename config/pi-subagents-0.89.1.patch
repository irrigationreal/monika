+			delete process.env.PI_SUBAGENTS_HOST_ACK_RESULTS;
+			process.env.PI_SUBAGENT_RUNTIME_ROOT = "/runtime/data";
+			delete process.env.PI_SUBAGENT_SESSION_ROOT;
+			assert.equal(hostOwnsArtifactRetention(), true);
+			process.env.PI_SUBAGENT_RUNTIME_ROOT = "relative";
+			assert.equal(hostOwnsArtifactRetention(), false);
+			process.env.PI_SUBAGENT_SESSION_ROOT = "/runtime/sessions";
+			assert.equal(hostOwnsArtifactRetention(), true);
+		} finally {
+			if (previousAck === undefined) delete process.env.PI_SUBAGENTS_HOST_ACK_RESULTS; else process.env.PI_SUBAGENTS_HOST_ACK_RESULTS = previousAck;
+			if (previousRoot === undefined) delete process.env.PI_SUBAGENT_RUNTIME_ROOT; else process.env.PI_SUBAGENT_RUNTIME_ROOT = previousRoot;
+			if (previousSessionRoot === undefined) delete process.env.PI_SUBAGENT_SESSION_ROOT; else process.env.PI_SUBAGENT_SESSION_ROOT = previousSessionRoot;
