@@ -0,0 +1,59 @@
+import assert from "node:assert/strict";
+import { createHash } from "node:crypto";
+import * as fs from "node:fs";
+import * as os from "node:os";
+import * as path from "node:path";
+import { describe, it } from "node:test";
+import { AwaitedResultPendingError, claimAwaitedResult } from "../../src/runs/background/result-claim.ts";
+
+function writeJson(file: string, value: Record<string, unknown>): Buffer {
+	const bytes = Buffer.from(`${JSON.stringify(value)}\n`, "utf8");
+	fs.mkdirSync(path.dirname(file), { recursive: true });
+	fs.writeFileSync(file, bytes);
+	return bytes;
+}
+
+describe("awaited result claims", () => {
+	it("keeps paused and partial publications unclaimable, then claims exact final resumed bytes", () => {
+		const root = fs.mkdtempSync(path.join(os.tmpdir(), "pi-awaited-result-claim-"));
+		try {
+			const runId = "run-claim-final";
+			const sessionId = "session-claim-final";
+			const asyncDir = path.join(root, "async-subagent-runs", runId);
+			const resultPath = path.join(root, "async-subagent-results", `${runId}.json`);
+			const identity = {
+				lifecycleArtifactVersion: 5,
+				runId,
+				sessionId,
+				asyncDir,
+				deliveryDisposition: "awaited",
+			};
+			writeJson(path.join(asyncDir, "launch.json"), { ...identity, state: "spawned", execution_state: "active", outcome_state: "pending" });
+
+			for (const state of ["paused", "partial"] as const) {
+				const execution_state = state === "paused" ? "interrupted" : "terminal";
+				const outcome_state = state === "paused" ? "interrupted" : "failed";
+				writeJson(path.join(asyncDir, "status.json"), { ...identity, state, execution_state, outcome_state });
+				writeJson(resultPath, { ...identity, state, execution_state, outcome_state, summary: `${state} bytes` });
+				assert.throws(
+					() => claimAwaitedResult({ asyncDir, runId, sessionId }),
+					(error) => error instanceof AwaitedResultPendingError && error.message.includes("not final"),
+				);
+				assert.equal(fs.existsSync(path.join(asyncDir, "result-claim.json")), false);
+			}
+
+			const final = { ...identity, state: "complete", execution_state: "terminal", outcome_state: "succeeded", summary: "exact resumed result" };
+			writeJson(path.join(asyncDir, "status.json"), final);
+			const finalBytes = writeJson(resultPath, final);
+			const claimed = claimAwaitedResult({ asyncDir, runId, sessionId, now: () => 1234 });
+			assert.equal(claimed.kind, "claimed");
+			if (claimed.kind !== "claimed") return;
+			assert.deepEqual(claimed.resultBytes, finalBytes);
+			assert.equal(claimed.claim.resultSha256, createHash("sha256").update(finalBytes).digest("hex"));
+			assert.equal(claimed.claim.resultSizeBytes, finalBytes.byteLength);
+			assert.equal(claimed.claim.claimedAt, 1234);
+		} finally {
+			fs.rmSync(root, { recursive: true, force: true });
+		}
+	});
+});
