diff --git a/src/workflows/workflow-cancellation-observer.ts b/src/workflows/workflow-cancellation-observer.ts
new file mode 100644
index 00000000..eac41f6f
--- /dev/null
+++ b/src/workflows/workflow-cancellation-observer.ts
@@ -0,0 +1,152 @@
+import * as fs from "node:fs";
+import * as path from "node:path";
+
+const MARKER_NAME = "host-cancellation.json";
+const STOP_NAME = path.join("control", "stop.json");
+const OPERATION_ID = /^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$/;
+const SAFE_MARKER_KEYS = new Set(["version", "kind", "operationId", "generation", "runId", "runKey", "runSessionId", "parentSessionId", "parentSessionPath", "requestedAt", "reason"]);
+const SAFE_STOP_KEYS = new Set(["type", "source", "operationId", "cancellationGeneration", "runId", "runKey", "runSessionId", "parentSessionId", "parentSessionPath", "reason", "ts"]);
+
+export interface WorkflowCancellationMarker {
+	version: 1;
+	kind: "host-cancellation";
+	operationId: string;
+	generation: number;
+	runId: string;
+	runKey: string;
+	runSessionId: string | null;
+	parentSessionId: string;
+	parentSessionPath: string | null;
+	requestedAt: number;
+	reason: string;
+}
+
+export interface WorkflowCancellationObserverOptions {
+	asyncDir: string;
+	runId: string;
+	sessionId?: string;
+	onCancel: (marker: WorkflowCancellationMarker) => void;
+	onError?: (error: unknown) => void;
+	pollIntervalMs?: number;
+}
+
+function regularFile(file: string): boolean {
+	try {
+		const stat = fs.lstatSync(file);
+		return stat.isFile() && !stat.isSymbolicLink();
+	} catch {
+		return false;
+	}
+}
+
+function object(value: unknown): value is Record<string, unknown> {
+	return Boolean(value) && typeof value === "object" && !Array.isArray(value);
+}
+
+function readJson(file: string): Record<string, unknown> | undefined {
+	if (!regularFile(file)) return undefined;
+	try {
+		const value: unknown = JSON.parse(fs.readFileSync(file, "utf8"));
+		return object(value) ? value : undefined;
+	} catch {
+		return undefined;
+	}
+}
+
+function safeOwnedDirectory(asyncDir: string, runId: string): boolean {
+	const rootValue = process.env.PI_SUBAGENT_RUNTIME_ROOT?.trim();
+	if (!rootValue || !path.isAbsolute(rootValue) || !path.isAbsolute(asyncDir)) return false;
+	try {
+		const root = fs.realpathSync(rootValue);
+		const asyncRoot = path.join(root, "async-subagent-runs");
+		const expected = path.join(asyncRoot, runId);
+		if (path.resolve(asyncDir) !== path.resolve(expected)) return false;
+		for (const file of [root, asyncRoot, asyncDir]) {
+			const stat = fs.lstatSync(file);
+			if (!stat.isDirectory() || stat.isSymbolicLink()) return false;
+		}
+		return fs.realpathSync(asyncDir) === path.resolve(expected);
+	} catch {
+		return false;
+	}
+}
+
+function validMarker(value: Record<string, unknown>, runId: string, sessionId?: string): boolean {
+	if ([...Object.keys(value)].some((key) => !SAFE_MARKER_KEYS.has(key))) return false;
+	return value.version === 1 && value.kind === "host-cancellation"
+		&& typeof value.operationId === "string" && OPERATION_ID.test(value.operationId)
+		&& Number.isSafeInteger(value.generation) && (value.generation as number) >= 0
+		&& value.runId === runId && value.runKey === `top:${runId}`
+		&& (value.runSessionId === null || (typeof value.runSessionId === "string" && (!sessionId || value.runSessionId === sessionId)))
+		&& typeof value.parentSessionId === "string" && value.parentSessionId.trim().length > 0
+		&& (!sessionId || value.parentSessionId === sessionId)
+		&& (value.parentSessionPath === null || typeof value.parentSessionPath === "string")
+		&& Number.isFinite(value.requestedAt) && typeof value.reason === "string" && value.reason.trim().length > 0;
+}
+
+function validStop(value: Record<string, unknown>, marker: WorkflowCancellationMarker): boolean {
+	if ([...Object.keys(value)].some((key) => !SAFE_STOP_KEYS.has(key))) return false;
+	return value.type === "stop" && value.source === "agentd-cancellation"
+		&& value.operationId === marker.operationId && value.cancellationGeneration === marker.generation
+		&& value.runId === marker.runId && value.runKey === marker.runKey
+		&& value.runSessionId === marker.runSessionId && value.parentSessionId === marker.parentSessionId
+		&& value.parentSessionPath === marker.parentSessionPath && value.reason === marker.reason
+		&& Number.isFinite(value.ts);
+}
+
+/** Observe agentd's durable cancellation record without trusting paths or host PIDs. */
+export function watchWorkflowCancellation(options: WorkflowCancellationObserverOptions): () => void {
+	let disposed = false;
+	let requested = false;
+	const report = (error: unknown): void => {
+		try { options.onError?.(error); } catch (reportError) { console.error("Workflow cancellation error reporter failed:", reportError); }
+	};
+	const check = (): void => {
+		if (disposed || requested) return;
+		if (!safeOwnedDirectory(options.asyncDir, options.runId)) return;
+		const markerValue = readJson(path.join(options.asyncDir, MARKER_NAME));
+		if (!markerValue) return;
+		if (!validMarker(markerValue, options.runId, options.sessionId)) {
+			report(new Error(`Ignoring workflow cancellation with mismatched identity for '${options.runId}'.`));
+			return;
+		}
+		const stopFile = path.join(options.asyncDir, STOP_NAME);
+		try {
+			const controlStat = fs.lstatSync(path.dirname(stopFile));
+			if (!controlStat.isDirectory() || controlStat.isSymbolicLink()) return;
+		} catch { return; }
+		let stopExists = false;
+		try { fs.lstatSync(stopFile); stopExists = true; } catch { /* no stop control is valid for terminal custody */ }
+		if (stopExists) {
+			const stopValue = readJson(stopFile);
+			if (!stopValue || !validStop(stopValue, markerValue as unknown as WorkflowCancellationMarker)) {
+				report(new Error(`Ignoring workflow stop control with mismatched identity for '${options.runId}'.`));
+				return;
+			}
+		}
+		requested = true;
+		try { options.onCancel(markerValue as unknown as WorkflowCancellationMarker); } catch (error) { report(error); }
+	};
+	check();
+	const watchers: fs.FSWatcher[] = [];
+	for (const target of [options.asyncDir, path.join(options.asyncDir, "control")]) {
+		try {
+			const watcher = fs.watch(target, () => check());
+			watcher.on("error", (error) => report(error));
+			watchers.push(watcher);
+		} catch (error) {
+			// The polling safety net remains authoritative when a directory watcher is unavailable.
+			if ((error as NodeJS.ErrnoException).code !== "ENOENT") report(error);
+		}
+	}
+	const timer = setInterval(check, options.pollIntervalMs ?? 1000);
+	timer.unref?.();
+	return () => {
+		if (disposed) return;
+		disposed = true;
+		for (const watcher of watchers) {
+			try { watcher.close(); } catch { /* already closed */ }
+		}
+		clearInterval(timer);
+	};
+}
