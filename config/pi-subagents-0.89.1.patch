--- /dev/null
+++ b/src/shared/monika-host.ts
@@ -0,0 +1,129 @@
+import * as fs from "node:fs";
+import * as path from "node:path";
+
+export type DeliveryDisposition = "awaited" | "follow_up" | "silent";
+
+export const MONIKA_LIFECYCLE_ARTIFACT_VERSION = 5 as const;
+
+export function hostOwnsResultDelivery(): boolean {
+	return process.env.PI_SUBAGENTS_HOST_ACK_RESULTS === "1";
+}
+
+export function hostIsDraining(): boolean {
+	return process.env.PI_SUBAGENTS_HOST_DRAINING === "1";
+}
+
+export function forceHostAsync(): boolean {
+	return process.env.PI_SUBAGENTS_FORCE_ASYNC === "1";
+}
+
+export function resolveDeliveryDisposition(value?: unknown): DeliveryDisposition {
+	const candidate = value ?? process.env.PI_SUBAGENTS_DEFAULT_DELIVERY_DISPOSITION ?? "follow_up";
+	if (candidate === "awaited" || candidate === "follow_up" || candidate === "silent") return candidate;
+	throw new Error(`Invalid subagent delivery disposition '${String(candidate)}'.`);
+}
+
+export function configuredSessionRoot(parentSessionFile: string | null, fallback: () => string): string {
+	const configured = process.env.PI_SUBAGENT_SESSION_ROOT?.trim();
+	if (!configured) return fallback();
+	if (!path.isAbsolute(configured)) throw new Error("PI_SUBAGENT_SESSION_ROOT must be absolute.");
+	if (!parentSessionFile) return path.join(path.resolve(configured), "unbound");
+	return path.join(path.resolve(configured), path.basename(parentSessionFile, ".jsonl"));
+}
+
+export function readRuntimeEpoch(): { runtimeInstanceId?: string; runtimeCreatedAt?: number } {
+	const file = process.env.MONIKA_RUNTIME_INSTANCE_FILE?.trim();
+	if (!file) return {};
+	try {
+		const value = JSON.parse(fs.readFileSync(file, "utf8")) as { id?: unknown; createdAt?: unknown };
+		return typeof value.id === "string" && typeof value.createdAt === "number" && Number.isFinite(value.createdAt)
+			? { runtimeInstanceId: value.id, runtimeCreatedAt: value.createdAt }
+			: {};
+	} catch {
+		return {};
+	}
+}
+
+export function linuxProcessStartTicks(pid: number | undefined): string | undefined {
+	if (!pid || process.platform !== "linux") return undefined;
+	try {
+		const stat = fs.readFileSync(`/proc/${pid}/stat`, "utf8");
+		const close = stat.lastIndexOf(")");
+		return stat.slice(close + 2).trim().split(/\s+/)[19];
+	} catch {
+		return undefined;
+	}
+}
+
+type LifecycleState = "queued" | "running" | "complete" | "failed" | "partial" | "paused" | "stopped" | "rejected" | string;
+
+/** Explicit adapter from upstream lifecycle v3 states to agentd's lifecycle v5 schema. */
+export function hostLifecycleFields(state: LifecycleState, disposition: DeliveryDisposition): Record<string, unknown> {
+	if (!hostOwnsResultDelivery()) return {};
+	const active = state === "queued" || state === "running" || state === "registered" || state === "launching";
+	const succeeded = state === "complete" || state === "completed";
+	const interrupted = state === "paused" || state === "stopped";
+	return {
+		lifecycleArtifactVersion: MONIKA_LIFECYCLE_ARTIFACT_VERSION,
+		deliveryDisposition: disposition,
+		execution_state: active ? "active" : interrupted ? "interrupted" : "terminal",
+		outcome_state: active ? "pending" : succeeded ? "succeeded" : interrupted ? "interrupted" : state === "failed" || state === "partial" || state === "rejected" ? "failed" : "unknown",
+		effects_state: "unknown",
+		delivery_state: "pending",
+	};
+}
+
+/** Lifecycle fields for a package-side rewrite without regressing host-owned effects/delivery evidence. */
+export function hostLifecycleTransitionFields(
+	state: LifecycleState,
+	dispositionInput: unknown,
+	asyncDir: string,
+	previous?: Record<string, unknown>,
+): Record<string, unknown> {
+	if (!hostOwnsResultDelivery()) return {};
+	const disposition = resolveDeliveryDisposition(dispositionInput);
+	const fields: Record<string, unknown> = { ...hostLifecycleFields(state, disposition), deliveryDisposition: disposition, asyncDir };
+	if (previous?.effects_state !== undefined) fields.effects_state = previous.effects_state;
+	if (previous?.delivery_state !== undefined) fields.delivery_state = previous.delivery_state;
+	return fields;
+}
+
+export function assertHostOriginRegistered(sessionFile: string | undefined, runId: string, asyncDir: string): void {
+	if (!hostOwnsResultDelivery()) return;
+	if (!sessionFile || !path.isAbsolute(sessionFile)) throw new Error("Host-owned async launch requires a persisted parent session file for origin registration.");
+	let entries: unknown[];
+	try {
+		entries = fs.readFileSync(sessionFile, "utf8").split("\n").filter(Boolean).map((line) => JSON.parse(line));
+	} catch (error) {
+		throw new Error(`Host async origin registration could not be read from '${sessionFile}': ${error instanceof Error ? error.message : String(error)}`);
+	}
+	const expectedSession = path.resolve(sessionFile);
+	const expectedDir = path.resolve(asyncDir);
+	const registered = entries.some((entry) => {
+		if (!entry || typeof entry !== "object" || Array.isArray(entry)) return false;
+		const item = entry as { type?: unknown; customType?: unknown; data?: unknown };
+		if (item.type !== "custom" || item.customType !== "monika.subagent.run" || !item.data || typeof item.data !== "object" || Array.isArray(item.data)) return false;
+		const data = item.data as { runId?: unknown; artifactSessionId?: unknown; asyncDir?: unknown; origin?: unknown };
+		if (data.runId !== runId || typeof data.artifactSessionId !== "string" || path.resolve(data.artifactSessionId) !== expectedSession
+			|| typeof data.asyncDir !== "string" || path.resolve(data.asyncDir) !== expectedDir
+			|| !data.origin || typeof data.origin !== "object" || Array.isArray(data.origin)) return false;
+		const origin = data.origin as { turnId?: unknown; topicId?: unknown; postId?: unknown };
+		return typeof origin.turnId === "string" && origin.turnId.length > 0
+			&& typeof origin.topicId === "string" && origin.topicId.length > 0
+			&& typeof origin.postId === "string" && origin.postId.length > 0;
+	});
+	if (!registered) {
+		throw new Error("Host did not durably register this async launch with a valid turn/topic/post origin; child start, result claims, and delivery are refused until a new launch can be reconciled.");
+	}
+}
+
+export function hostWakeAllowed(disposition: DeliveryDisposition, asyncDir?: string): boolean {
+	if (disposition !== "follow_up" || hostIsDraining()) return false;
+	if (!hostOwnsResultDelivery() || !asyncDir) return true;
+	try {
+		const marker = fs.lstatSync(path.join(asyncDir, "host-cancellation.json"));
+		return !marker.isFile() || marker.isSymbolicLink();
+	} catch (error) {
+		return (error as NodeJS.ErrnoException).code === "ENOENT";
+	}
+}
