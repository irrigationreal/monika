--- /dev/null
+++ b/src/runs/background/result-claim.ts
@@ -0,0 +1,183 @@
+import { createHash } from "node:crypto";
+import * as fs from "node:fs";
+import * as path from "node:path";
+import type { DeliveryDisposition } from "../../shared/types.ts";
+
+export const RESULT_CLAIM_VERSION = 1 as const;
+
+export interface ResultClaimV1 {
+	version: typeof RESULT_CLAIM_VERSION;
+	kind: "pi-subagents.result-claim";
+	runId: string;
+	runKey: string;
+	sessionId: string;
+	deliveryDisposition: "awaited";
+	resultSha256: string;
+	resultSizeBytes: number;
+	claimedAt: number;
+}
+
+export class AwaitedResultPendingError extends Error {
+	readonly resultPath: string;
+
+	constructor(resultPath: string, reason?: string) {
+		super(reason ?? `Awaited result is not published yet at '${resultPath}'.`);
+		this.name = "AwaitedResultPendingError";
+		this.resultPath = resultPath;
+	}
+}
+
+export type AwaitedResultClaim = {
+	kind: "claimed";
+	claim: ResultClaimV1;
+	claimPath: string;
+	resultPath: string;
+	resultBytes: Buffer;
+	result: Record<string, unknown>;
+	idempotent: boolean;
+} | {
+	kind: "not-claimable";
+	deliveryDisposition: Exclude<DeliveryDisposition, "awaited">;
+};
+
+function readRegularNoFollow(filePath: string): Buffer {
+	let fd: number | undefined;
+	try {
+		fd = fs.openSync(filePath, fs.constants.O_RDONLY | (fs.constants.O_NOFOLLOW ?? 0));
+		const stat = fs.fstatSync(fd);
+		if (!stat.isFile()) throw new Error(`Refusing non-regular file '${filePath}'.`);
+		return fs.readFileSync(fd);
+	} finally {
+		if (fd !== undefined) fs.closeSync(fd);
+	}
+}
+
+function parseObject(bytes: Buffer, label: string): Record<string, unknown> {
+	let value: unknown;
+	try {
+		value = JSON.parse(bytes.toString("utf-8"));
+	} catch (error) {
+		throw new Error(`Malformed ${label}: ${error instanceof Error ? error.message : String(error)}`);
+	}
+	if (!value || typeof value !== "object" || Array.isArray(value)) throw new Error(`Malformed ${label}: expected an object.`);
+	return value as Record<string, unknown>;
+}
+
+function resolveRunIdentity(asyncDirInput: string, expectedRunId?: string): { asyncDir: string; runId: string; runKey: string; resultPath: string } {
+	const asyncDir = path.resolve(asyncDirInput);
+	const dirStat = fs.lstatSync(asyncDir);
+	if (!dirStat.isDirectory() || dirStat.isSymbolicLink()) throw new Error(`Refusing unsafe async directory '${asyncDir}'.`);
+	const canonicalDir = fs.realpathSync(asyncDir);
+	if (canonicalDir !== asyncDir) throw new Error(`Refusing aliased async directory '${asyncDir}'.`);
+	const runId = path.basename(asyncDir);
+	if (!runId || runId === "." || runId === ".." || (expectedRunId !== undefined && runId !== expectedRunId)) {
+		throw new Error(`Async run identity mismatch for '${asyncDir}'.`);
+	}
+	const parent = path.dirname(asyncDir);
+	if (path.basename(parent) === "async-subagent-runs") {
+		const runtimeRoot = path.dirname(parent);
+		return { asyncDir, runId, runKey: `top:${runId}`, resultPath: path.join(runtimeRoot, "async-subagent-results", `${runId}.json`) };
+	}
+	const rootRunId = path.basename(parent);
+	const nestedRoot = path.dirname(parent);
+	if (path.basename(nestedRoot) !== "nested-subagent-runs" || !rootRunId) throw new Error(`Async directory is outside a recognized run scope: '${asyncDir}'.`);
+	const runtimeRoot = path.dirname(nestedRoot);
+	return {
+		asyncDir,
+		runId,
+		runKey: `nested:${rootRunId}:${runId}`,
+		resultPath: path.join(runtimeRoot, "async-subagent-results", "nested", rootRunId, `${runId}.json`),
+	};
+}
+
+function assertLifecycleRecord(
+	filePath: string,
+	label: string,
+	expected: { runId: string; sessionId: string; disposition: DeliveryDisposition },
+): Record<string, unknown> {
+	const value = parseObject(readRegularNoFollow(filePath), label);
+	if (value.lifecycleArtifactVersion !== 5) throw new Error(`${label} is not a lifecycle v5 artifact.`);
+	if ((value.runId ?? value.id) !== expected.runId) throw new Error(`${label} run identity mismatch.`);
+	if (value.sessionId !== expected.sessionId) throw new Error(`${label} session identity mismatch.`);
+	if (value.deliveryDisposition !== expected.disposition) throw new Error(`${label} delivery disposition mismatch.`);
+	return value;
+}
+
+function assertFinalAwaitedArtifact(value: Record<string, unknown>, label: string, resultPath: string): void {
+	const state = value.state;
+	const finalState = state === "complete" || state === "failed" || state === "rejected";
+	if (!finalState || value.execution_state !== "terminal" || (value.outcome_state !== "succeeded" && value.outcome_state !== "failed")) {
+		throw new AwaitedResultPendingError(resultPath, `${label} is not final (state=${String(state)}).`);
+	}
+}
+
+function sameClaim(a: Record<string, unknown>, b: ResultClaimV1): boolean {
+	const allowed = new Set(["version", "kind", "runId", "runKey", "sessionId", "deliveryDisposition", "resultSha256", "resultSizeBytes", "claimedAt"]);
+	return Object.keys(a).every((key) => allowed.has(key))
+		&& a.version === b.version && a.kind === b.kind && a.runId === b.runId && a.runKey === b.runKey
+		&& a.sessionId === b.sessionId && a.deliveryDisposition === b.deliveryDisposition
+		&& a.resultSha256 === b.resultSha256 && a.resultSizeBytes === b.resultSizeBytes
+		&& typeof a.claimedAt === "number" && Number.isFinite(a.claimedAt);
+}
+
+function createClaimNoFollow(claimPath: string, claim: ResultClaimV1): { claim: ResultClaimV1; idempotent: boolean } {
+	let fd: number | undefined;
+	try {
+		fd = fs.openSync(claimPath, fs.constants.O_WRONLY | fs.constants.O_CREAT | fs.constants.O_EXCL | (fs.constants.O_NOFOLLOW ?? 0), 0o600);
+		fs.writeFileSync(fd, `${JSON.stringify(claim)}\n`, "utf-8");
+		fs.fsyncSync(fd);
+		return { claim, idempotent: false };
+	} catch (error) {
+		if ((error as NodeJS.ErrnoException).code !== "EEXIST") throw error;
+		const existing = parseObject(readRegularNoFollow(claimPath), "result claim");
+		if (!sameClaim(existing, claim)) throw new Error(`Conflicting result claim at '${claimPath}'.`);
+		return { claim: existing as unknown as ResultClaimV1, idempotent: true };
+	} finally {
+		if (fd !== undefined) fs.closeSync(fd);
+	}
+}
+
+/** Read and identity-bind one exact awaited result, then atomically publish its sidecar. */
+export function claimAwaitedResult(input: { asyncDir: string; runId?: string; sessionId: string; now?: () => number }): AwaitedResultClaim {
+	const identity = resolveRunIdentity(input.asyncDir, input.runId);
+	const statusPath = path.join(identity.asyncDir, "status.json");
+	const launchPath = path.join(identity.asyncDir, "launch.json");
+	const status = parseObject(readRegularNoFollow(statusPath), "status artifact");
+	const disposition = status.deliveryDisposition;
+	if (disposition === "follow_up" || disposition === "silent") return { kind: "not-claimable", deliveryDisposition: disposition };
+	if (disposition !== "awaited") throw new Error("Status artifact has an invalid delivery disposition.");
+	const expected = { runId: identity.runId, sessionId: input.sessionId, disposition: disposition as DeliveryDisposition };
+	const checkedStatus = assertLifecycleRecord(statusPath, "status artifact", expected);
+	assertLifecycleRecord(launchPath, "launch artifact", expected);
+	assertFinalAwaitedArtifact(checkedStatus, "Status artifact", identity.resultPath);
+	let resultBytes: Buffer;
+	try {
+		resultBytes = readRegularNoFollow(identity.resultPath);
+	} catch (error) {
+		if ((error as NodeJS.ErrnoException).code === "ENOENT") throw new AwaitedResultPendingError(identity.resultPath);
+		throw error;
+	}
+	const result = parseObject(resultBytes, "result artifact");
+	if (result.lifecycleArtifactVersion !== 5 || (result.runId ?? result.id) !== identity.runId || result.sessionId !== input.sessionId
+		|| result.asyncDir !== identity.asyncDir || result.deliveryDisposition !== disposition) {
+		throw new Error("Result artifact identity or disposition mismatch.");
+	}
+	assertFinalAwaitedArtifact(result, "Result artifact", identity.resultPath);
+	if (result.state !== checkedStatus.state || result.execution_state !== checkedStatus.execution_state || result.outcome_state !== checkedStatus.outcome_state) {
+		throw new AwaitedResultPendingError(identity.resultPath, "Awaited status and result artifacts do not describe the same final publication.");
+	}
+	const claim: ResultClaimV1 = {
+		version: RESULT_CLAIM_VERSION,
+		kind: "pi-subagents.result-claim",
+		runId: identity.runId,
+		runKey: identity.runKey,
+		sessionId: input.sessionId,
+		deliveryDisposition: "awaited",
+		resultSha256: createHash("sha256").update(resultBytes).digest("hex"),
+		resultSizeBytes: resultBytes.byteLength,
+		claimedAt: (input.now ?? Date.now)(),
+	};
+	const claimPath = path.join(identity.asyncDir, "result-claim.json");
+	const published = createClaimNoFollow(claimPath, claim);
+	return { kind: "claimed", claim: published.claim, claimPath, resultPath: identity.resultPath, resultBytes, result, idempotent: published.idempotent };
+}
