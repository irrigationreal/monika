+    assert.deepEqual(targets.map(executionTargetStatusFields), [
+      {},
+      { executionTarget: { kind: "ssh", name: "stanza" }, executionTargetDigest: "a".repeat(64) },
+      { executionTarget: { kind: "ssh", name: "stanza" }, executionTargetDigest: "b".repeat(64) },
+      {},
+    ]);
+  });
+
+  it("aggregates runtime-materialized effects by final evidence index with unknown winning", () => {
+    const dir = mkdtempSync(path.join(tmpdir(), "execution-dynamic-effects-"));
+    const remote = { kind: "ssh", public: { kind: "ssh", name: "stanza" } } as any;
+    const runtimeTargets: any[] = [undefined, undefined, remote];
+    runtimeTargets.splice(1, 1, remote, undefined); // one dynamic placeholder -> two materialized children
+    writeFileSync(path.join(dir, "1.jsonl"), `${JSON.stringify({ phase: "intent", id: "dynamic" })}\n${JSON.stringify({ phase: "settled", id: "dynamic", effects_state: "confirmed" })}\n`);
