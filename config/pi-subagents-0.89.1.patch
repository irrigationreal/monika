+      descriptor,
+      lockExtensionPath: "/extensions/ssh.ts",
+      lockCodeDigest: "c".repeat(64),
+    };
+    assert.deepEqual(executionTargetChildLaunch(remote, "/run/effects.jsonl"), {
+      extensions: ["/extensions/ssh.ts"],
+      env: {
+        MONIKA_SSH_LOCK_DESCRIPTOR: "/registry/stanza.json",
+        PI_SUBAGENT_SSH_LOCK_CODE_DIGEST: "c".repeat(64),
+        PI_SUBAGENT_EXECUTION_TARGET_NAME: "stanza",
+        PI_SUBAGENT_EXECUTION_TARGET_DIGEST: "d".repeat(64),
+        PI_SUBAGENT_EFFECTS_EVIDENCE_PATH: "/run/effects.jsonl",
+      },
+    });
+  });
