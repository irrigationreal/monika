@@ -0,0 +1,64 @@
+import assert from "node:assert/strict";
+import { describe, it } from "node:test";
+import { resolveLaunchBinding } from "../../src/shared/launch-contract.ts";
+import type { AgentConfig } from "../../src/agents/agents.ts";
+
+const toolPlan = {
+	effectiveToolAllowlist: ["read"],
+	excludeTools: [],
+	extensionArgs: [],
+	effectiveMcpTools: [],
+};
+
+const common = {
+	task: "inspect the boundary",
+	model: "provider/model",
+	fast: false,
+	thinking: "low",
+	systemPrompt: "Be precise.",
+	toolPlan,
+};
+
+function digestForPersistedStep(deliveryDisposition?: "awaited" | "follow_up" | "silent"): string {
+	return resolveLaunchBinding({
+		definitionDigest: "a".repeat(64),
+		systemPromptMode: "replace",
+		inheritProjectContext: false,
+		inheritGlobalContext: false,
+		inheritSkills: false,
+		...common,
+		...(deliveryDisposition ? { deliveryDisposition } : {}),
+	}).launchContractDigest;
+}
+
+function digestForAgent(deliveryDisposition?: "awaited" | "follow_up" | "silent"): string {
+	const agent = {
+		name: "worker",
+		description: "test worker",
+		systemPromptMode: "replace",
+		inheritProjectContext: false,
+		inheritGlobalContext: false,
+		inheritSkills: false,
+	} as AgentConfig;
+	return resolveLaunchBinding({
+		agent,
+		...common,
+		...(deliveryDisposition ? { deliveryDisposition } : {}),
+	}).launchContractDigest;
+}
+
+describe("Monika delivery disposition launch binding", () => {
+	it("binds disposition for both agent and persisted chain-step identities", () => {
+		assert.notEqual(digestForAgent("awaited"), digestForAgent("follow_up"));
+		assert.notEqual(digestForPersistedStep("awaited"), digestForPersistedStep("follow_up"));
+		assert.equal(digestForAgent("awaited"), digestForAgent("awaited"));
+		assert.equal(digestForPersistedStep("silent"), digestForPersistedStep("silent"));
+	});
+
+	it("keeps the ordinary non-host projection unchanged when disposition is absent", () => {
+		assert.equal(digestForAgent(), digestForAgent());
+		assert.equal(digestForPersistedStep(), digestForPersistedStep());
+		assert.notEqual(digestForAgent(), digestForAgent("follow_up"));
+		assert.notEqual(digestForPersistedStep(), digestForPersistedStep("follow_up"));
+	});
+});
