index 00000000..dbacc1d0
--- /dev/null
+++ b/test/unit/workflow-cancellation-observer.test.ts
@@ -0,0 +1,65 @@
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import test from "node:test";
+import { watchWorkflowCancellation } from "../../src/workflows/workflow-cancellation-observer.ts";
+
+function fixture() {
+	const root = fs.mkdtempSync(path.join(os.tmpdir(), "pi-workflow-cancel-"));
+	const runId = "workflow-run";
+	const asyncDir = path.join(root, "async-subagent-runs", runId);
+	fs.mkdirSync(path.join(asyncDir, "control"), { recursive: true });
+	return { root, runId, asyncDir };
+}
+
+function marker(runId: string, operationId = "operation-1") {
+	return { version: 1, kind: "host-cancellation", operationId, generation: 4, runId, runKey: `top:${runId}`, runSessionId: "session-1", parentSessionId: "session-1", parentSessionPath: "/sessions/parent.jsonl", requestedAt: Date.now(), reason: "forum-stop" };
+}
+
+function stop(value: ReturnType<typeof marker>) {
+	return { type: "stop", source: "agentd-cancellation", operationId: value.operationId, cancellationGeneration: value.generation, runId: value.runId, runKey: value.runKey, runSessionId: value.runSessionId, parentSessionId: value.parentSessionId, parentSessionPath: value.parentSessionPath, reason: value.reason, ts: Date.now() };
+}
+
+test("durable cancellation validates identity and reaches the live controller once", async () => {
+	const f = fixture();
+	const prior = process.env.PI_SUBAGENT_RUNTIME_ROOT;
+	process.env.PI_SUBAGENT_RUNTIME_ROOT = f.root;
+	const controller = new AbortController();
+	let calls = 0;
+	const dispose = watchWorkflowCancellation({ asyncDir: f.asyncDir, runId: f.runId, sessionId: "session-1", onCancel: (value) => { calls++; controller.abort(new Error(value.reason)); } });
+	try {
+		const value = marker(f.runId);
+		fs.writeFileSync(path.join(f.asyncDir, "host-cancellation.json"), JSON.stringify(value));
+		fs.writeFileSync(path.join(f.asyncDir, "control", "stop.json"), JSON.stringify(stop(value)));
+		for (let i = 0; i < 30 && !controller.signal.aborted; i++) await new Promise((resolve) => setTimeout(resolve, 10));
+		assert.equal(controller.signal.aborted, true);
+		assert.equal(calls, 1);
+		assert.equal((controller.signal.reason as Error).message, "forum-stop");
+	} finally {
+		dispose();
+		if (prior === undefined) delete process.env.PI_SUBAGENT_RUNTIME_ROOT; else process.env.PI_SUBAGENT_RUNTIME_ROOT = prior;
+		fs.rmSync(f.root, { recursive: true, force: true });
+	}
+});
+
+test("mismatched durable controls do not stop a controller and disposal stops polling", async () => {
+	const f = fixture();
+	const prior = process.env.PI_SUBAGENT_RUNTIME_ROOT;
+	process.env.PI_SUBAGENT_RUNTIME_ROOT = f.root;
+	let calls = 0;
+	const dispose = watchWorkflowCancellation({ asyncDir: f.asyncDir, runId: f.runId, sessionId: "session-1", pollIntervalMs: 5, onCancel: () => { calls++; } });
+	try {
+		fs.writeFileSync(path.join(f.asyncDir, "host-cancellation.json"), JSON.stringify({ ...marker(f.runId), runKey: "top:other" }));
+		await new Promise((resolve) => setTimeout(resolve, 30));
+		assert.equal(calls, 0);
+		dispose();
+		fs.writeFileSync(path.join(f.asyncDir, "host-cancellation.json"), JSON.stringify(marker(f.runId, "after-dispose")));
+		await new Promise((resolve) => setTimeout(resolve, 30));
+		assert.equal(calls, 0);
+	} finally {
+		dispose();
+		if (prior === undefined) delete process.env.PI_SUBAGENT_RUNTIME_ROOT; else process.env.PI_SUBAGENT_RUNTIME_ROOT = prior;
+		fs.rmSync(f.root, { recursive: true, force: true });
+	}
+});
