+import assert from "node:assert/strict";
+import * as fs from "node:fs";
+import * as os from "node:os";
+import * as path from "node:path";
+import { describe, it } from "node:test";
+import { assertHostOriginRegistered } from "../../src/shared/monika-host.ts";
+
+describe("Monika host origin registration", () => {
+	it("uses the synchronously persisted canonical mapping as the event handoff acknowledgement", () => {
+		const root = fs.mkdtempSync(path.join(os.tmpdir(), "pi-host-origin-"));
+		const previous = process.env.PI_SUBAGENTS_HOST_ACK_RESULTS;
+		try {
+			process.env.PI_SUBAGENTS_HOST_ACK_RESULTS = "1";
+			const sessionFile = path.join(root, "parent.jsonl");
+			const asyncDir = path.join(root, "runs", "run-1");
+			fs.writeFileSync(sessionFile, `${JSON.stringify({
+				type: "custom",
+				customType: "monika.subagent.run",
+				data: {
+					runId: "run-1",
+					artifactSessionId: sessionFile,
+					asyncDir,
+					origin: { turnId: "turn-1", topicId: "topic-1", postId: "post-1" },
+				},
+			})}\n`);
+			assert.doesNotThrow(() => assertHostOriginRegistered(sessionFile, "run-1", asyncDir));
+			fs.writeFileSync(sessionFile, `${JSON.stringify({
+				type: "custom", customType: "monika.subagent.run",
+				data: { runId: "run-1", artifactSessionId: sessionFile, asyncDir, origin: { turnId: null, topicId: null, postId: null } },
+			})}\n`);
+			assert.throws(() => assertHostOriginRegistered(sessionFile, "run-1", asyncDir), /did not durably register.*valid turn\/topic\/post origin/);
+		} finally {
+			if (previous === undefined) delete process.env.PI_SUBAGENTS_HOST_ACK_RESULTS;
+			else process.env.PI_SUBAGENTS_HOST_ACK_RESULTS = previous;
+			fs.rmSync(root, { recursive: true, force: true });
+		}
+	});
+});
