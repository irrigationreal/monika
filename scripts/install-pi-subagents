#!/bin/sh
set -eu

readonly repository='https://github.com/nicobailon/pi-subagents.git'
readonly commit='8063333661476ca48afbca826dc4aab8707c72d3'
readonly tree='3b8583d2c2ccba99a8e800c8650f6f3214f02646'
readonly version='0.37.2'
readonly npm_integrity='sha512-pf7DxLBY9pFY3grOFgRfMqoS9QbElWP2ULOCOnmJNrCEvjlA81fiyp0wk1vSaJPJ/rjsP0lA1sAk7S/QD+Olpg=='
readonly index_sha256='4319c40fc4012b5749ca7e96182488b19dc0b0b980b2d9fecd28078c17e6d073'
readonly fanout_sha256='8cfba3086dbb460c59c18ebbe7bd04f3020f457d3e7ed5c91dc53dbfa9c5aa08'
readonly package_sha256='c16ef2da0e9c009c30ab736ee65d190608ade81cc06b2bbf3716c28ffe01e5ff'
readonly lock_sha256='9c7df83850424712291ed90ca41f417eb2ad4b046fefad6d309ee96eb77f7d03'
readonly shared_types_sha256='00c42591eb78cac931dc0274f56ce7e2a4fb1db69760f7e65975a0b3f883f5b8'
readonly notify_sha256='e772d3f871fc68dcca2b2a84f9c4076b5f7a74078d900c84ceb32cdaad17a27d'
readonly result_watcher_sha256='8e4134ba18d25120f277fe5e0f3ca42a133363bf8c60dabdd35bcc69e63a32d7'
readonly async_execution_sha256='a5b7226a51d06a8ee6e3481da531d69582982fc956a2629c54669e4e388bd5de'
readonly subagent_runner_sha256='6606844cf510708675b0b5db760e308e2060d59ea043b1faf4fdcc3bb7b4b39d'
readonly fork_context_sha256='ce98de6183f77cbc50c3cf9d4c169b7ae70d592f59f0310999fbff0430c95a62'
readonly subagent_executor_sha256='00cc26cd6b9d5142bbbc3c0484434fc64d15e5cad1530cce97321fc78feaf5f6'
readonly fork_context_test_sha256='bb4d9706e24f1d015a58d695c828a699fc54e83f832b4ab8359562e244a002d2'
readonly fork_execution_test_sha256='51a0fd1faf3f179aade5cb83a13527b27ad58e803513eae009a8e1f5d830790d'
readonly notify_test_sha256='9aec8ddf82dd085ea5c7ecda3404f2c4e6b33007f7f208487a6773406e9b1d77'
readonly native_supervisor_sha256='325db18a42abfe0465a70ad6c0bbb01179d05090f40071da1c819fc2f51fd8a8'
readonly native_supervisor_test_sha256='3c9f7a93219c08edff6460aadb1d15c8f45cd929377421e72d9f43dcc5ec5bc4'
readonly temp_paths_test_sha256='dd986167d727162322995ad11a1a7082df7fb6ff80f5a315f8d29469e6396ecb'
readonly result_watcher_test_sha256='597b1353e00b09e7c3b4981cdc75896c6fc0d0fcaac97365f7202923a8ddeb57'
readonly agents_agents_sha256='ab8d6691f089512c7388c821a34bf7078644df1a4723e151f63db09f711c9765'
readonly agents_chain_serializer_sha256='f17fdd8fd7af2b29e2ef26c8cbfd1fe51ea822216ad2f0b2d3d2ffc8981a9482'
readonly api_preflight_sha256='b0c89f952f1652c0888ea2d4cbe233fbab3489b8d7b4cc45e763f6991e48e259'
readonly extension_rpc_sha256='f6313ecddca0469c492262ec5e970b9fb9938ba7d1f52feb07d992d3b1773aa4'
readonly extension_schemas_sha256='14558baf3ae22dec38df0fd22ef7c35288ad320a60a542d8cc8c43776673883c'
readonly runs_background_async_resume_sha256='2086bf999998948ea76b76a2e2f03d2c19b7a22217aab305b17e1c3c69e6d111'
readonly runs_background_async_status_sha256='2b670746ef86b7939f78a1813f2ed06d425094e45695c34d49b27daa1bf4557d'
readonly runs_background_scheduled_runs_sha256='38a43841d5bcdd260257be84c6113137266cd377aa6871fe8be1bbb48bd0e255'
readonly runs_foreground_chain_execution_sha256='6ddca26cfd3beaa3a88898a157979b11e5f55372aad42c5300b3862418ed2112'
readonly runs_foreground_execution_sha256='feda771ced7ab2f5c8714204172cae01979c57b5904576bddedf5c6399687319'
readonly runs_shared_dynamic_fanout_sha256='97ffe1d8e036753fd98094d912ea27b1212859a39ee39f7692081ebb60764f9b'
readonly runs_shared_parallel_utils_sha256='3ab2772140eac32c2a975b6fe72825ca1406302109dfd17b4018e32c52ec0eac'
readonly runs_shared_pi_args_sha256='a16569b104a78d40fa837701e37a95aa55ea4a1cccf97dedb59125d404d9d7d6'
readonly shared_launch_contract_sha256='5db8afb438f36a5484e5a2f9f6e1978ab4e3f3cea04d38c1122dbbf78295f61b'
readonly shared_settings_sha256='f2f178c6767559c13f612cc5cc455a8a3d3708e0f594448fa3b614b61ae2fde2'
readonly tui_fleet_status_sha256='91d369a9f94da17c77d04b1b85e3301d03db119b7c790cc250a8ddfa13e1b5ba'
readonly async_recovery_descriptor_test_sha256='a9af381c6620ae9850588c890b14cf57ba5f8c50df56c5be94a73121b87dd6e1'
readonly async_resume_test_sha256='453608365665f51b543088411b5cc417a38d517ff958a532653d2acc2d4a3b8a'
readonly chain_serializer_test_sha256='aa05d7f2bc784d8cab83fc2e5e5eb72befacfa515fe4fc1ab1e2d2cefff9a8c7'
readonly control_channel_test_sha256='27761e1e817fa9c6cf44c7c112e60648df3f3c6a069c189ca7a72f905ad264ff'
readonly package_manifest_test_sha256='b46fb55c48c0a06a668043f410eae2d4507bbc034490ec612360429b228616b3'
readonly pi_args_test_sha256='f8844fe71a7ca7f2337fb42e15e178641f7c0abeca79a1171beb1e4c6c48f188'
readonly preflight_test_sha256='9dc214bef34e0fd87611b0cfa88d678fc609bd6fe611073d94294bb2c27378cf'
readonly scheduled_runs_test_sha256='93e2a1f802616b96d1add13f7ededb19a16e0bfd4890f192185f1db7f4558ec3'
readonly schemas_test_sha256='862ce9232e80d9984feb0c471da0ddcf340226e014d2735723587f55789bc320'
readonly patch_sha256='03594026b03d1d7e5e7ffb9b2b18893b6360036f854e7e81f6cbfe3458487929'

if [ "$#" -ne 2 ]; then
  echo "usage: $0 <destination> <patch>" >&2
  exit 2
fi

destination="$1"
patch="$(realpath "$2")"
test ! -e "$destination"
printf '%s  %s\n' "$patch_sha256" "$patch" | sha256sum --check --strict -

git clone --quiet --no-checkout "$repository" "$destination"
git -C "$destination" checkout --quiet --detach "$commit"
test "$(git -C "$destination" rev-parse HEAD)" = "$commit"
test "$(git -C "$destination" rev-parse 'HEAD^{tree}')" = "$tree"
printf '%s  %s\n' \
  "$index_sha256" "$destination/src/extension/index.ts" \
  "$fanout_sha256" "$destination/src/extension/fanout-child.ts" \
  "$package_sha256" "$destination/package.json" \
  "$lock_sha256" "$destination/package-lock.json" \
  "$shared_types_sha256" "$destination/src/shared/types.ts" \
  "$notify_sha256" "$destination/src/runs/background/notify.ts" \
  "$result_watcher_sha256" "$destination/src/runs/background/result-watcher.ts" \
  "$async_execution_sha256" "$destination/src/runs/background/async-execution.ts" \
  "$subagent_runner_sha256" "$destination/src/runs/background/subagent-runner.ts" \
  "$fork_context_sha256" "$destination/src/shared/fork-context.ts" \
  "$subagent_executor_sha256" "$destination/src/runs/foreground/subagent-executor.ts" \
  "$fork_context_test_sha256" "$destination/test/unit/fork-context.test.ts" \
  "$fork_execution_test_sha256" "$destination/test/integration/fork-context-execution.test.ts" \
  "$notify_test_sha256" "$destination/test/unit/notify.test.ts" \
  "$native_supervisor_sha256" "$destination/src/intercom/native-supervisor-channel.ts" \
  "$native_supervisor_test_sha256" "$destination/test/unit/native-supervisor-channel.test.ts" \
  "$temp_paths_test_sha256" "$destination/test/unit/temp-paths.test.ts" \
  "$result_watcher_test_sha256" "$destination/test/integration/result-watcher.test.ts" \
  "$agents_agents_sha256" "$destination/src/agents/agents.ts" \
  "$agents_chain_serializer_sha256" "$destination/src/agents/chain-serializer.ts" \
  "$api_preflight_sha256" "$destination/src/api/preflight.ts" \
  "$extension_rpc_sha256" "$destination/src/extension/rpc.ts" \
  "$extension_schemas_sha256" "$destination/src/extension/schemas.ts" \
  "$runs_background_async_resume_sha256" "$destination/src/runs/background/async-resume.ts" \
  "$runs_background_async_status_sha256" "$destination/src/runs/background/async-status.ts" \
  "$runs_background_scheduled_runs_sha256" "$destination/src/runs/background/scheduled-runs.ts" \
  "$runs_foreground_chain_execution_sha256" "$destination/src/runs/foreground/chain-execution.ts" \
  "$runs_foreground_execution_sha256" "$destination/src/runs/foreground/execution.ts" \
  "$runs_shared_dynamic_fanout_sha256" "$destination/src/runs/shared/dynamic-fanout.ts" \
  "$runs_shared_parallel_utils_sha256" "$destination/src/runs/shared/parallel-utils.ts" \
  "$runs_shared_pi_args_sha256" "$destination/src/runs/shared/pi-args.ts" \
  "$shared_launch_contract_sha256" "$destination/src/shared/launch-contract.ts" \
  "$shared_settings_sha256" "$destination/src/shared/settings.ts" \
  "$tui_fleet_status_sha256" "$destination/src/tui/fleet-status.ts" \
  "$async_recovery_descriptor_test_sha256" "$destination/test/unit/async-recovery-descriptor.test.ts" \
  "$async_resume_test_sha256" "$destination/test/unit/async-resume.test.ts" \
  "$chain_serializer_test_sha256" "$destination/test/unit/chain-serializer.test.ts" \
  "$control_channel_test_sha256" "$destination/test/unit/control-channel.test.ts" \
  "$package_manifest_test_sha256" "$destination/test/unit/package-manifest.test.ts" \
  "$pi_args_test_sha256" "$destination/test/unit/pi-args.test.ts" \
  "$preflight_test_sha256" "$destination/test/unit/preflight.test.ts" \
  "$scheduled_runs_test_sha256" "$destination/test/unit/scheduled-runs.test.ts" \
  "$schemas_test_sha256" "$destination/test/unit/schemas.test.ts" \
  | sha256sum --check --strict -

node - "$destination/package.json" "$destination/package-lock.json" "$version" <<'NODE'
const fs = require('node:fs');
const [packagePath, lockPath, expectedVersion] = process.argv.slice(2);
const manifest = JSON.parse(fs.readFileSync(packagePath, 'utf8'));
const lock = JSON.parse(fs.readFileSync(lockPath, 'utf8'));
if (manifest.name !== 'pi-subagents' || manifest.version !== expectedVersion) {
  throw new Error(`Unexpected package identity: ${manifest.name}@${manifest.version}`);
}
if (lock.lockfileVersion !== 3 || lock.packages?.['']?.version !== expectedVersion) {
  throw new Error('Unexpected pi-subagents lockfile identity');
}
NODE

git -C "$destination" apply --check "$patch"
git -C "$destination" apply "$patch"
git -C "$destination" diff --check

# Branch-gate image builds run the patched package's execution-target, launch,
# scheduling, resume, schema, and passive-result regression set before pruning
# to production dependencies. The reviewed lockfile pins every tarball;
# lifecycle scripts remain unnecessary and disabled in both installs.
if [ "${PI_SUBAGENTS_VERIFY_TESTS:-0}" = 1 ]; then
  (cd "$destination" && npm ci --ignore-scripts && \
    node test/support/isolated-test-runner.mjs unit \
      async-recovery-descriptor.test.ts async-resume.test.ts chain-serializer.test.ts control-channel.test.ts \
      execution-target.test.ts package-manifest.test.ts pi-args.test.ts preflight.test.ts \
      scheduled-runs.test.ts schemas.test.ts && \
    node test/support/isolated-test-runner.mjs integration \
      async-execution.test.ts fork-context-execution.test.ts result-watcher.test.ts top-level-async.test.ts)
  rm -rf "$destination/node_modules"
fi
(cd "$destination" && npm ci --omit=dev --ignore-scripts)

cat > "$destination/REVIEWED_SOURCE.json" <<EOF
{
  "name": "pi-subagents",
  "version": "$version",
  "repository": "$repository",
  "gitHead": "$commit",
  "gitTree": "$tree",
  "npmArtifactIntegrity": "$npm_integrity",
  "packageLockSha256": "$lock_sha256",
  "patchSha256": "$patch_sha256"
}
EOF
rm -rf "$destination/.git"
