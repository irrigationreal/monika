#!/bin/sh
set -eu

# Exact upstream object + self-contained reviewed patch. Never resolve a branch
# or a release tag at install time. The previous pin remains in Git history.
readonly repository='https://github.com/nicobailon/pi-subagents.git'
readonly commit='533033f0e906e85fdb0e909ce27a7c499ffb6485'
readonly tree='d6c8cf1dbf40704d3d5f8b0530908e9f6aa6afce'
readonly version='0.89.1'
readonly lock_sha256='5fc39baec198a9b58887e7fabefed9dc8a4df7dcbf42839992263b9a1639776b'
readonly patch_sha256='82ac29c51b4ee536899d8aff48a7c3ac9dcdf4e84f2b2fb03ff46589aa09fd1a'

if [ "$#" -ne 2 ]; then
  echo "usage: $0 <destination> <patch>" >&2
  exit 2
fi
destination="$1"
patch="$(realpath "$2")"
test ! -e "$destination"
printf '%s  %s\n' "$patch_sha256" "$patch" | sha256sum --check --strict -
git clone --quiet --no-checkout "$repository" "$destination"
git -C "$destination" checkout --quiet --detach "$commit"
test "$(git -C "$destination" rev-parse HEAD)" = "$commit"
test "$(git -C "$destination" rev-parse 'HEAD^{tree}')" = "$tree"
# The exact tree authenticates every source file, including file modes. Git
# verifies object bytes on extraction; retain an explicit dependency-graph hash.
printf '%s  %s\n' "$lock_sha256" "$destination/package-lock.json" | sha256sum --check --strict -

node - "$destination/package.json" "$destination/package-lock.json" "$version" <<'NODE'
const fs = require('node:fs');
const [packagePath, lockPath, expectedVersion] = process.argv.slice(2);
const manifest = JSON.parse(fs.readFileSync(packagePath, 'utf8'));
const lock = JSON.parse(fs.readFileSync(lockPath, 'utf8'));
if (manifest.name !== 'pi-subagents' || manifest.version !== expectedVersion) {
  throw new Error(`Unexpected package identity: ${manifest.name}@${manifest.version}`);
}
if (lock.lockfileVersion !== 3 || lock.packages?.['']?.version !== expectedVersion) {
  throw new Error('Unexpected pi-subagents lockfile identity');
}
NODE

git -C "$destination" apply --check "$patch"
git -C "$destination" apply "$patch"
git -C "$destination" diff --check

# Upstream tests isolate HOME/temp/runtime state. Run the integration loader for
# its SDK fixtures; do not execute tests against deployment roots or databases.
if [ "${PI_SUBAGENTS_VERIFY_TESTS:-0}" = 1 ]; then
  (cd "$destination" && npm ci --ignore-scripts && npm run typecheck && \
    node --experimental-strip-types --import ./test/support/isolated-temp-root.mjs --test \
      test/unit/execution-target.test.ts test/unit/monika-launch-contract.test.ts \
      test/unit/monika-host.test.ts test/unit/workflow-cancellation-observer.test.ts test/unit/result-claim.test.ts test/unit/async-resume.test.ts \
      test/unit/extension-bindings.test.ts test/unit/schemas.test.ts test/unit/workflow-scripts-feature.test.ts \
      test/unit/subagent-wait.test.ts test/unit/notify.test.ts test/unit/preflight.test.ts \
      test/unit/fork-context.test.ts && \
    node --experimental-strip-types --import ./test/support/register-loader.mjs --test \
      test/integration/fork-context-execution.test.ts test/integration/result-watcher.test.ts \
      test/integration/top-level-async.test.ts test/integration/workflow-result-publication.test.ts)
  rm -rf "$destination/node_modules"
fi
(cd "$destination" && npm ci --omit=dev --ignore-scripts)
cat > "$destination/REVIEWED_SOURCE.json" <<EOF
{
  "name": "pi-subagents",
  "version": "$version",
  "repository": "$repository",
  "gitHead": "$commit",
  "gitTree": "$tree",
  "packageLockSha256": "$lock_sha256",
  "patchSha256": "$patch_sha256"
}
EOF
rm -rf "$destination/.git"
