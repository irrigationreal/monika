#!/usr/bin/env bash
set -euo pipefail

# Pull and apply the Monika + forum images only when the runtime reports that
# stopping containers is safe. Exit 75 (EX_TEMPFAIL) when a deploy should be
# retried later rather than forced.
#
# By default, this script only drains/backs up/recreates containers when a pull
# changes the target image ID for at least one managed service. Use
# --backup-only to create a quiescence-gated backup without deploying.

MODE="deploy"
if [ "${1:-}" = "--backup-only" ]; then
  MODE="backup-only"
  shift
fi
if [ "$#" -ne 0 ]; then
  echo "usage: $0 [--backup-only]" >&2
  exit 64
fi

ROOT="${MONIKA_DEPLOY_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
COMPOSE_FILE="${MONIKA_DEPLOY_COMPOSE_FILE:-$ROOT/compose.yaml}"
AGENTD_URL="${MONIKA_AGENTD_BASE_URL:-http://127.0.0.1:${MONIKA_AGENTD_PORT:-7724}}"
FORUM_URL="${MONIKA_FORUM_BASE_URL:-http://127.0.0.1:4310/api}"
FORUM_READY_URL="${MONIKA_FORUM_READY_URL:-http://127.0.0.1:4310/readyz}"
FORUM_POST_DEPLOY_TIMEOUT_MS="${MONIKA_FORUM_POST_DEPLOY_TIMEOUT_MS:-120000}"
FORUM_DEPLOY_TOKEN="${MONIKA_FORUM_DEPLOY_TOKEN:-${CODEX_FORUM_DEPLOY_TOKEN:-}}"
FORUM_ADMISSION_WAIT_TIMEOUT_MS="${MONIKA_FORUM_ADMISSION_WAIT_TIMEOUT_MS:-30000}"
FORUM_ADMISSION_LEASE_MS="${MONIKA_FORUM_ADMISSION_LEASE_MS:-1800000}"
FORUM_CURL_MAX_TIME_SECONDS="${MONIKA_FORUM_CURL_MAX_TIME_SECONDS:-5}"
FORUM_ADMISSION_OPERATION_ID="forum-deploy-$(date -u +%Y%m%dT%H%M%SZ)-$$-$(python3 -c 'import uuid; print(uuid.uuid4())')"
AGENTD_DRAIN_TIMEOUT_MS="${MONIKA_AGENTD_DRAIN_TIMEOUT_MS:-0}"
AGENTD_DRAIN_AUTO_CANCEL_MS="${MONIKA_AGENTD_DRAIN_AUTO_CANCEL_MS:-900000}"
AGENTD_POST_DEPLOY_TIMEOUT_MS="${MONIKA_AGENTD_POST_DEPLOY_TIMEOUT_MS:-120000}"
BACKUP_DIR="${MONIKA_DEPLOY_BACKUP_DIR:-$ROOT/runtime/backups/redeploy}"
BACKUP_COMPRESSION="${MONIKA_DEPLOY_BACKUP_COMPRESSION:-auto}"
BACKUP_ZSTD_LEVEL="${MONIKA_DEPLOY_BACKUP_ZSTD_LEVEL:-3}"
BACKUP_GZIP_LEVEL="${MONIKA_DEPLOY_BACKUP_GZIP_LEVEL:-6}"
DOCKER_PRUNE_UNTIL="${MONIKA_DEPLOY_DOCKER_PRUNE_UNTIL:-168h}"
REQUIRE_GIT_CURRENT="${MONIKA_DEPLOY_REQUIRE_GIT_CURRENT:-1}"
PUBLIC_INGRESS="${MONIKA_PUBLIC_INGRESS:-0}"
SUDO_BIN="${MONIKA_DEPLOY_SUDO_BIN:-/run/wrappers/bin/sudo}"
TAR_BIN="${MONIKA_DEPLOY_TAR_BIN:-}"
BACKUP_COMPRESSOR=""
BACKUP_COMPRESSION_RESOLVED=""
BACKUP_ARCHIVE_EXTENSION=""
RELEASE_CHANNEL="${MONIKA_RELEASE_CHANNEL:-main}"
STABLE_RELEASE_API_URL="${MONIKA_STABLE_RELEASE_API_URL:-https://api.github.com/repos/irrigationreal/monika/releases/latest}"
STABLE_RELEASE_TOKEN="${MONIKA_STABLE_RELEASE_TOKEN:-}"
STABLE_RELEASE_COMMIT=""
STABLE_RELEASE_TAG=""
STABLE_METADATA_DIR=""
EXPLICIT_IMAGE_OVERRIDES=0

DRAIN_STARTED=0
CANCEL_DRAIN_ON_EXIT=0
FORUM_ADMISSION_ACQUIRED=0
MONIKA_UPDATE_NEEDED=0
FORUM_UPDATE_NEEDED=0
COMPOSE_ARGS=(-f "$COMPOSE_FILE")
STATUS_SERVICES=(monika forum)
if [ "$PUBLIC_INGRESS" = "1" ]; then
  COMPOSE_ARGS+=(--profile public-ingress)
  STATUS_SERVICES+=(cloudflared)
fi

compose() {
  docker compose "${COMPOSE_ARGS[@]}" "$@"
}

json_field() {
  python3 -c 'import json,sys; data=json.load(sys.stdin); expr=sys.argv[1].split("."); v=data
for part in expr:
    v = v.get(part) if isinstance(v, dict) else None
print("true" if v is True else "false" if v is False else "" if v is None else v)' "$1"
}

epoch_ms() {
  python3 -c 'import time; print(int(time.time() * 1000))'
}

remaining_timeout_seconds() {
  python3 - "$1" "$2" <<'PY'
import sys
import time

deadline_ms = int(sys.argv[1])
maximum_seconds = float(sys.argv[2])
remaining_ms = deadline_ms - int(time.time() * 1000)
if remaining_ms <= 0 or maximum_seconds <= 0:
    raise SystemExit(1)
print(f"{min(maximum_seconds, remaining_ms / 1000):.3f}")
PY
}

tempfail() {
  echo "deploy deferred: $*" >&2
  exit 75
}

configure_image_selection() {
  local monika_is_set=0 forum_is_set=0
  [ "${MONIKA_IMAGE+x}" = "x" ] && monika_is_set=1
  [ "${MONIKA_FORUM_IMAGE+x}" = "x" ] && forum_is_set=1

  if [ "$monika_is_set" != "$forum_is_set" ]; then
    echo "MONIKA_IMAGE and MONIKA_FORUM_IMAGE must be set together" >&2
    exit 64
  fi
  if [ "$monika_is_set" = "1" ]; then
    if [ -z "$MONIKA_IMAGE" ] || [ -z "$MONIKA_FORUM_IMAGE" ]; then
      echo "MONIKA_IMAGE and MONIKA_FORUM_IMAGE must both be non-empty" >&2
      exit 64
    fi
    EXPLICIT_IMAGE_OVERRIDES=1
    export MONIKA_IMAGE MONIKA_FORUM_IMAGE
    return 0
  fi

  case "$RELEASE_CHANNEL" in
    main)
      export MONIKA_IMAGE="ghcr.io/irrigationreal/monika:main"
      export MONIKA_FORUM_IMAGE="ghcr.io/irrigationreal/monika-forum:main"
      ;;
    stable)
      # Stable references are resolved after the git-current and optional
      # public-ingress gates, before any application quiescence begins.
      ;;
    *)
      echo "unsupported MONIKA_RELEASE_CHANNEL: $RELEASE_CHANNEL (expected main or stable)" >&2
      exit 64
      ;;
  esac
}

release_curl() {
  local output_file="$1" url="$2" accept="$3"
  local -a headers=(-H "accept: $accept")
  if [ -n "$STABLE_RELEASE_TOKEN" ]; then
    headers+=(-H "authorization: Bearer $STABLE_RELEASE_TOKEN")
  fi
  curl -fsS -L \
    --connect-timeout 5 \
    --max-time 15 \
    --max-redirs 3 \
    --max-filesize 1048576 \
    --proto '=https' \
    --proto-redir '=https' \
    "${headers[@]}" \
    -o "$output_file" \
    "$url"
}

resolve_stable_release() {
  local canonical_api latest_json asset_json validated asset_url canonical_source=0
  canonical_api="https://api.github.com/repos/irrigationreal/monika/releases/latest"
  if [ "$STABLE_RELEASE_API_URL" = "$canonical_api" ]; then
    canonical_source=1
    STABLE_RELEASE_TOKEN="${GITHUB_TOKEN:-}"
  else
    case "$STABLE_RELEASE_API_URL" in
      https://*) ;;
      *) tempfail "custom stable release API URL must use HTTPS" ;;
    esac
    [ -n "$STABLE_RELEASE_TOKEN" ] || \
      tempfail "custom stable release API requires MONIKA_STABLE_RELEASE_TOKEN; GITHUB_TOKEN is never sent to custom URLs"
  fi

  STABLE_METADATA_DIR="$(mktemp -d)"
  latest_json="$STABLE_METADATA_DIR/latest.json"
  asset_json="$STABLE_METADATA_DIR/stable-manifests.json"
  release_curl "$latest_json" "$STABLE_RELEASE_API_URL" "application/vnd.github+json" || \
    tempfail "stable release API is unavailable"

  validated="$STABLE_METADATA_DIR/release-fields"
  if ! python3 - "$latest_json" "$STABLE_RELEASE_API_URL" "$canonical_source" > "$validated" <<'PY'
import json
import re
import sys
from pathlib import Path
from urllib.parse import urlsplit

def strict_object(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise ValueError(f"duplicate JSON field: {key}")
        result[key] = value
    return result

try:
    data = json.loads(Path(sys.argv[1]).read_text(), object_pairs_hook=strict_object)
    api_url = urlsplit(sys.argv[2])
    canonical = sys.argv[3] == "1"
    if not isinstance(data, dict):
        raise ValueError("latest-release response must be an object")
    if data.get("draft") is not False or data.get("prerelease") is not False:
        raise ValueError("latest release must be neither draft nor prerelease")
    tag = data.get("tag_name")
    commit = data.get("target_commitish")
    if not isinstance(tag, str) or not re.fullmatch(r"[0-9A-Za-z][0-9A-Za-z._-]{0,127}", tag):
        raise ValueError("release tag is invalid")
    if not isinstance(commit, str) or not re.fullmatch(r"[0-9a-f]{40}", commit):
        raise ValueError("release target_commitish must be a full lowercase commit SHA")
    assets = data.get("assets")
    if not isinstance(assets, list):
        raise ValueError("release assets must be an array")
    matches = [asset for asset in assets if isinstance(asset, dict) and asset.get("name") == "stable-manifests.json"]
    if len(matches) != 1:
        raise ValueError("release must contain exactly one stable-manifests.json asset")
    asset_url = matches[0].get("url")
    if not isinstance(asset_url, str):
        raise ValueError("stable manifest asset URL is missing")
    parsed_asset = urlsplit(asset_url)
    if parsed_asset.scheme != "https" or not parsed_asset.netloc or parsed_asset.username or parsed_asset.password:
        raise ValueError("stable manifest asset URL must be HTTPS without userinfo")
    if (parsed_asset.scheme, parsed_asset.hostname, parsed_asset.port) != (api_url.scheme, api_url.hostname, api_url.port):
        raise ValueError("stable manifest asset URL must use the release API origin")
    if canonical and not re.fullmatch(r"/repos/irrigationreal/monika/releases/assets/[1-9][0-9]*", parsed_asset.path):
        raise ValueError("canonical stable manifest asset URL is invalid")
    for value in (tag, commit, asset_url):
        if "\n" in value or "\r" in value:
            raise ValueError("release fields must not contain line breaks")
    print(tag)
    print(commit)
    print(asset_url)
except Exception as exc:
    print(f"stable release metadata invalid: {exc}", file=sys.stderr)
    raise SystemExit(1)
PY
  then
    tempfail "stable latest-release metadata failed validation"
  fi
  {
    IFS= read -r STABLE_RELEASE_TAG
    IFS= read -r STABLE_RELEASE_COMMIT
    IFS= read -r asset_url
  } < "$validated"

  release_curl "$asset_json" "$asset_url" "application/octet-stream" || \
    tempfail "stable-manifests.json is unavailable"
  validated="$STABLE_METADATA_DIR/contract-fields"
  if ! python3 - "$asset_json" "$STABLE_RELEASE_TAG" "$STABLE_RELEASE_COMMIT" > "$validated" <<'PY'
import json
import re
import sys
from pathlib import Path

MONIKA_REPOSITORY = "ghcr.io/irrigationreal/monika"
FORUM_REPOSITORY = "ghcr.io/irrigationreal/monika-forum"

def strict_object(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise ValueError(f"duplicate JSON field: {key}")
        result[key] = value
    return result

try:
    data = json.loads(Path(sys.argv[1]).read_text(), object_pairs_hook=strict_object)
    if not isinstance(data, dict) or set(data) != {"schemaVersion", "deploymentContractVersion", "stableTag", "commit", "images"}:
        raise ValueError("asset has unknown or missing top-level fields")
    if type(data["schemaVersion"]) is not int or data["schemaVersion"] != 1:
        raise ValueError("schemaVersion must equal 1")
    if type(data["deploymentContractVersion"]) is not int or data["deploymentContractVersion"] != 1:
        raise ValueError("deploymentContractVersion must equal 1")
    if data["stableTag"] != sys.argv[2]:
        raise ValueError("stableTag does not match the latest release")
    if data["commit"] != sys.argv[3] or not re.fullmatch(r"[0-9a-f]{40}", data["commit"]):
        raise ValueError("commit does not match the latest release")
    images = data["images"]
    if not isinstance(images, dict) or set(images) != {"monika", "forum"}:
        raise ValueError("images must contain exactly monika and forum")
    expected = {"monika": MONIKA_REPOSITORY, "forum": FORUM_REPOSITORY}
    output = []
    for name in ("monika", "forum"):
        image = images[name]
        if not isinstance(image, dict) or set(image) != {"repository", "manifestDigest"}:
            raise ValueError(f"{name} image has unknown or missing fields")
        if image["repository"] != expected[name]:
            raise ValueError(f"{name} repository is not canonical")
        digest = image["manifestDigest"]
        if not isinstance(digest, str) or not re.fullmatch(r"sha256:[0-9a-f]{64}", digest):
            raise ValueError(f"{name} manifestDigest is invalid")
        output.append(f"{image['repository']}@{digest}")
    print(*output, sep="\n")
except Exception as exc:
    print(f"stable manifest contract invalid: {exc}", file=sys.stderr)
    raise SystemExit(1)
PY
  then
    tempfail "stable-manifests.json failed validation"
  fi
  {
    IFS= read -r MONIKA_IMAGE
    IFS= read -r MONIKA_FORUM_IMAGE
  } < "$validated"
  export MONIKA_IMAGE MONIKA_FORUM_IMAGE
  echo "resolved stable release $STABLE_RELEASE_TAG at $STABLE_RELEASE_COMMIT"
}

release_deploy_guards() {
  if [ -n "$STABLE_METADATA_DIR" ]; then
    rm -rf "$STABLE_METADATA_DIR"
  fi
  if [ "$DRAIN_STARTED" = "1" ] && [ "$CANCEL_DRAIN_ON_EXIT" = "1" ]; then
    curl -fsS --max-time "$FORUM_CURL_MAX_TIME_SECONDS" -X POST "$AGENTD_URL/v1/admin/drain/cancel" >/dev/null 2>&1 || true
  fi
  if [ "$FORUM_ADMISSION_ACQUIRED" = "1" ] && [ -n "$FORUM_DEPLOY_TOKEN" ]; then
    curl -fsS --max-time "$FORUM_CURL_MAX_TIME_SECONDS" -X POST "$FORUM_URL/deploy/admission/cancel" \
      -H "authorization: Bearer $FORUM_DEPLOY_TOKEN" \
      -H 'content-type: application/json' \
      --data "{\"operationId\":\"${FORUM_ADMISSION_OPERATION_ID}\"}" >/dev/null 2>&1 || true
  fi
}
trap release_deploy_guards EXIT

forum_curl() {
  if [ -z "$FORUM_DEPLOY_TOKEN" ]; then
    echo "MONIKA_FORUM_DEPLOY_TOKEN or CODEX_FORUM_DEPLOY_TOKEN is required for forum deploy API access" >&2
    exit 78
  fi
  curl -fsS -H "authorization: Bearer $FORUM_DEPLOY_TOKEN" "$@"
}

legacy_wait_forum_quiescence() {
  local deadline probe_timeout state safe
  deadline=$(( $(epoch_ms) + FORUM_ADMISSION_WAIT_TIMEOUT_MS ))
  echo "forum deployment admission endpoint is unavailable; using bounded legacy quiescence for one-release rollout" >&2
  while true; do
    probe_timeout="$(remaining_timeout_seconds "$deadline" "$FORUM_CURL_MAX_TIME_SECONDS")" || \
      tempfail "legacy forum quiescence did not become safe within ${FORUM_ADMISSION_WAIT_TIMEOUT_MS}ms"
    state="$(forum_curl --max-time "$probe_timeout" "$FORUM_URL/deploy/quiescence")" || \
      tempfail "legacy forum quiescence endpoint unavailable"
    safe="$(printf '%s' "$state" | json_field safeToStop)"
    if [ "$safe" = "true" ]; then
      FORUM_ADMISSION_ACQUIRED=0
      return 0
    fi
    probe_timeout="$(remaining_timeout_seconds "$deadline" 1)" || continue
    sleep "$probe_timeout"
  done
}

acquire_forum_admission() {
  local state acquired operation_id curl_timeout_seconds response_file http_status curl_status
  curl_timeout_seconds="$(python3 - "$FORUM_ADMISSION_WAIT_TIMEOUT_MS" <<'PY'
import sys

try:
    wait_ms = int(sys.argv[1])
except ValueError:
    raise SystemExit("MONIKA_FORUM_ADMISSION_WAIT_TIMEOUT_MS must be a positive integer")
if wait_ms <= 0:
    raise SystemExit("MONIKA_FORUM_ADMISSION_WAIT_TIMEOUT_MS must be greater than 0")
print(f"{(wait_ms + 5000) / 1000:.3f}")
PY
)"
  [ -n "$FORUM_DEPLOY_TOKEN" ] || {
    echo "MONIKA_FORUM_DEPLOY_TOKEN or CODEX_FORUM_DEPLOY_TOKEN is required for forum deploy API access" >&2
    exit 78
  }
  # The server may acquire the lease even if curl loses the response. Mark it
  # before the request so the exit trap best-effort cancels that uncertainty.
  FORUM_ADMISSION_ACQUIRED=1
  response_file="$(mktemp)"
  set +e
  http_status="$(curl -sS --max-time "$curl_timeout_seconds" -o "$response_file" -w '%{http_code}' \
    -H "authorization: Bearer $FORUM_DEPLOY_TOKEN" -H 'content-type: application/json' \
    -X POST "$FORUM_URL/deploy/admission/acquire" \
    --data "{\"operationId\":\"${FORUM_ADMISSION_OPERATION_ID}\",\"waitTimeoutMs\":${FORUM_ADMISSION_WAIT_TIMEOUT_MS},\"leaseMs\":${FORUM_ADMISSION_LEASE_MS}}")"
  curl_status=$?
  set -e
  state="$(cat "$response_file")"
  rm -f "$response_file"
  [ "$curl_status" -eq 0 ] || tempfail "forum deployment admission was blocked or unavailable"
  if [ "$http_status" = "404" ]; then
    FORUM_ADMISSION_ACQUIRED=0
    legacy_wait_forum_quiescence
    return 0
  fi
  [ "$http_status" -ge 200 ] && [ "$http_status" -lt 300 ] || \
    tempfail "forum deployment admission was not acquired (HTTP $http_status): $state"
  acquired="$(printf '%s' "$state" | json_field acquired)"
  operation_id="$(printf '%s' "$state" | json_field operationId)"
  [ "$acquired" = "true" ] && [ "$operation_id" = "$FORUM_ADMISSION_OPERATION_ID" ] || \
    tempfail "forum deployment admission returned an invalid ownership response: $state"
  FORUM_ADMISSION_ACQUIRED=1
  echo "forum deployment admission acquired: $FORUM_ADMISSION_OPERATION_ID"
}

cancel_forum_admission() {
  if [ "$FORUM_ADMISSION_ACQUIRED" != "1" ]; then
    return 0
  fi
  forum_curl --max-time "$FORUM_CURL_MAX_TIME_SECONDS" -X POST "$FORUM_URL/deploy/admission/cancel" \
    -H 'content-type: application/json' \
    --data "{\"operationId\":\"${FORUM_ADMISSION_OPERATION_ID}\"}" >/dev/null
  FORUM_ADMISSION_ACQUIRED=0
  echo "forum deployment admission cancelled"
}

drain_agentd() {
  local state status safe
  state="$(curl -fsS "$AGENTD_URL/v1/admin/quiescence")" || tempfail "agentd quiescence endpoint unavailable"
  status="$(printf '%s' "$state" | json_field status)"
  if [ "$status" = "blocked" ]; then
    tempfail "agentd is blocked: $state"
  fi

  # POST /drain even when quiescence already says safe_to_stop. The drain API
  # is the deploy lock that rejects new conversations/messages between the
  # safety check and Docker sending SIGTERM.
  DRAIN_STARTED=1
  CANCEL_DRAIN_ON_EXIT=1
  state="$(curl -fsS -X POST "$AGENTD_URL/v1/admin/drain" \
    -H 'content-type: application/json' \
    --data "{\"timeout_ms\":${AGENTD_DRAIN_TIMEOUT_MS},\"auto_cancel_ms\":${AGENTD_DRAIN_AUTO_CANCEL_MS}}")" || tempfail "agentd drain failed"

  safe="$(printf '%s' "$state" | json_field ok)"
  [ "$safe" = "true" ] || tempfail "agentd is not safe to stop after drain: $state"
}

wait_for_agentd_drain_cancel_after_deploy() {
  if [ "$DRAIN_STARTED" != "1" ]; then
    return 0
  fi

  local deadline probe_timeout state draining_state health_status
  deadline=$(( $(epoch_ms) + AGENTD_POST_DEPLOY_TIMEOUT_MS ))
  while true; do
    probe_timeout="$(remaining_timeout_seconds "$deadline" "$FORUM_CURL_MAX_TIME_SECONDS")" || {
      echo "agentd did not become healthy/undrained after deploy within ${AGENTD_POST_DEPLOY_TIMEOUT_MS}ms" >&2
      return 1
    }
    if state="$(curl -fsS --max-time "$probe_timeout" -X POST "$AGENTD_URL/v1/admin/drain/cancel" 2>/dev/null)"; then
      draining_state="$(printf '%s' "$state" | json_field draining)"
      if probe_timeout="$(remaining_timeout_seconds "$deadline" "$FORUM_CURL_MAX_TIME_SECONDS")" &&
        health_status="$(curl -fsS --max-time "$probe_timeout" "$AGENTD_URL/healthz" 2>/dev/null | json_field status)"; then
        if [ "$draining_state" = "false" ] && [ "$health_status" = "healthy" ]; then
          CANCEL_DRAIN_ON_EXIT=0
          echo "agentd drain cancelled after deploy"
          return 0
        fi
      fi
    fi
    probe_timeout="$(remaining_timeout_seconds "$deadline" 2)" || continue
    sleep "$probe_timeout"
  done
}

wait_for_forum_ready_after_deploy() {
  local deadline probe_timeout
  deadline=$(( $(epoch_ms) + FORUM_POST_DEPLOY_TIMEOUT_MS ))
  while true; do
    probe_timeout="$(remaining_timeout_seconds "$deadline" "$FORUM_CURL_MAX_TIME_SECONDS")" || {
      echo "forum did not become ready after deploy within ${FORUM_POST_DEPLOY_TIMEOUT_MS}ms" >&2
      return 1
    }
    if curl -fsS --max-time "$probe_timeout" "$FORUM_READY_URL" >/dev/null 2>&1; then
      echo "forum ready after deploy"
      return 0
    fi
    probe_timeout="$(remaining_timeout_seconds "$deadline" 2)" || continue
    sleep "$probe_timeout"
  done
}

require_git_current() {
  if [ "$REQUIRE_GIT_CURRENT" != "1" ]; then
    return 0
  fi
  if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    tempfail "deploy root is not a git worktree"
  fi

  local branch upstream_remote upstream_ref behind
  branch="$(git symbolic-ref --quiet --short HEAD 2>/dev/null)" || tempfail "live checkout is detached or has no branch"
  upstream_remote="$(git config "branch.$branch.remote" || true)"
  [ -n "$upstream_remote" ] || tempfail "live checkout branch $branch has no upstream remote"
  upstream_ref="$(git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null)" || tempfail "live checkout branch $branch has no upstream"

  git fetch --quiet "$upstream_remote" || tempfail "could not fetch git state from $upstream_remote"
  git diff --quiet --ignore-submodules -- || tempfail "live checkout has unstaged tracked changes"
  git diff --cached --quiet --ignore-submodules -- || tempfail "live checkout has staged changes"
  behind="$(git rev-list --count "HEAD..$upstream_ref")"
  [ "$behind" = "0" ] || tempfail "live checkout is behind $upstream_ref by $behind commits; pull/reconcile before deploying images"
}

container_image_id() {
  local service="$1" cid
  cid="$(compose ps -q "$service" 2>/dev/null || true)"
  if [ -z "$cid" ]; then
    return 0
  fi
  docker inspect -f '{{.Image}}' "$cid"
}

image_id() {
  local image="$1"
  docker image inspect -f '{{.Id}}' "$image" 2>/dev/null || true
}

image_revision() {
  local image="$1" revision
  revision="$(docker image inspect -f '{{ index .Config.Labels "org.opencontainers.image.revision" }}' "$image" 2>/dev/null || true)"
  [ "$revision" != "<no value>" ] || revision=""
  printf '%s' "$revision"
}

container_revision() {
  local service="$1" cid revision
  cid="$(compose ps -q "$service" 2>/dev/null || true)"
  if [ -z "$cid" ]; then
    return 0
  fi
  revision="$(docker inspect -f '{{ index .Config.Labels "org.opencontainers.image.revision" }}' "$cid" 2>/dev/null || true)"
  [ "$revision" != "<no value>" ] || revision=""
  printf '%s' "$revision"
}

stable_revision_guards() {
  local monika_target_revision forum_target_revision service running_revision
  monika_target_revision="$(image_revision "$MONIKA_IMAGE")"
  forum_target_revision="$(image_revision "$MONIKA_FORUM_IMAGE")"
  if [ "$monika_target_revision" != "$STABLE_RELEASE_COMMIT" ] || \
     [ "$forum_target_revision" != "$STABLE_RELEASE_COMMIT" ]; then
    tempfail "stable image OCI revision labels do not match release commit $STABLE_RELEASE_COMMIT"
  fi

  if [ "${MONIKA_DEPLOY_ALLOW_STABLE_MIGRATION:-0}" = "1" ]; then
    echo "stable migration acknowledgement accepted for this deploy attempt"
    return 0
  fi

  for service in monika forum; do
    running_revision="$(container_revision "$service")"
    # No running container is a fresh-install path. Exact revision equality and
    # an ancestor relationship are safe forward advances.
    [ -n "$running_revision" ] || {
      if [ -z "$(compose ps -q "$service" 2>/dev/null || true)" ]; then
        continue
      fi
      tempfail "$service running image revision is missing; retry once with MONIKA_DEPLOY_ALLOW_STABLE_MIGRATION=1 after review"
    }
    if [ "$running_revision" = "$STABLE_RELEASE_COMMIT" ]; then
      continue
    fi
    if [[ "$running_revision" =~ ^[0-9a-f]{40}$ ]] && \
       git cat-file -e "${running_revision}^{commit}" 2>/dev/null && \
       git cat-file -e "${STABLE_RELEASE_COMMIT}^{commit}" 2>/dev/null && \
       git merge-base --is-ancestor "$running_revision" "$STABLE_RELEASE_COMMIT" 2>/dev/null; then
      continue
    fi
    tempfail "$service running revision $running_revision is not a known ancestor of stable $STABLE_RELEASE_COMMIT; retry once with MONIKA_DEPLOY_ALLOW_STABLE_MIGRATION=1 after review"
  done
}

run_as_backup_reader() {
  if [ "$(id -u)" = "0" ]; then
    "$@"
  elif [ -x "$SUDO_BIN" ]; then
    "$SUDO_BIN" -n env PATH="$PATH" "$@"
  else
    sudo -n env PATH="$PATH" "$@"
  fi
}

is_gnu_tar() {
  "$1" --version 2>/dev/null | grep -q 'GNU tar'
}

resolve_tar_bin() {
  if [ -n "$TAR_BIN" ]; then
    if ! command -v "$TAR_BIN" >/dev/null 2>&1; then
      echo "configured MONIKA_DEPLOY_TAR_BIN is not executable: $TAR_BIN" >&2
      exit 69
    fi
    TAR_BIN="$(command -v "$TAR_BIN")"
    if ! is_gnu_tar "$TAR_BIN"; then
      echo "configured MONIKA_DEPLOY_TAR_BIN is not GNU tar: $TAR_BIN" >&2
      exit 69
    fi
    return 0
  fi

  if command -v tar >/dev/null 2>&1 && is_gnu_tar tar; then
    TAR_BIN="$(command -v tar)"
    return 0
  fi
  if command -v gtar >/dev/null 2>&1 && is_gnu_tar gtar; then
    TAR_BIN="$(command -v gtar)"
    return 0
  fi

  echo "GNU tar is required for redeploy backups." >&2
  echo "Install it on macOS with: brew install gnu-tar zstd" >&2
  echo "Or set MONIKA_DEPLOY_TAR_BIN to a GNU tar executable." >&2
  exit 69
}

require_command() {
  local command_name="$1"
  local install_hint="$2"
  if ! command -v "$command_name" >/dev/null 2>&1; then
    echo "$command_name is required for redeploy backups." >&2
    echo "$install_hint" >&2
    exit 69
  fi
}

resolve_backup_compression() {
  case "$BACKUP_COMPRESSION" in
    auto)
      if command -v zstd >/dev/null 2>&1; then
        BACKUP_COMPRESSION_RESOLVED="zstd"
      else
        BACKUP_COMPRESSION_RESOLVED="gzip"
      fi
      ;;
    zstd|gzip)
      BACKUP_COMPRESSION_RESOLVED="$BACKUP_COMPRESSION"
      ;;
    *)
      echo "unsupported MONIKA_DEPLOY_BACKUP_COMPRESSION: $BACKUP_COMPRESSION" >&2
      echo "Supported values: auto, zstd, gzip" >&2
      exit 64
      ;;
  esac

  case "$BACKUP_COMPRESSION_RESOLVED" in
    zstd)
      require_command zstd "Install it on macOS with: brew install zstd"
      BACKUP_COMPRESSOR="zstd -T0 -$BACKUP_ZSTD_LEVEL"
      BACKUP_ARCHIVE_EXTENSION="tar.zst"
      ;;
    gzip)
      require_command gzip "gzip is normally available by default; install gzip or set MONIKA_DEPLOY_BACKUP_COMPRESSION=zstd."
      BACKUP_COMPRESSOR="gzip -n -$BACKUP_GZIP_LEVEL"
      BACKUP_ARCHIVE_EXTENSION="tar.gz"
      ;;
  esac
}

verify_backup_compression() {
  case "$BACKUP_COMPRESSION_RESOLVED" in
    zstd) zstd -t "$1" >/dev/null ;;
    gzip) gzip -t "$1" >/dev/null ;;
  esac
}

backup_needs_sudo() {
  if [ "$(id -u)" = "0" ]; then
    return 1
  fi

  python3 - "$ROOT" <<'PY'
import os
import sys
from pathlib import Path

root = Path(sys.argv[1]).resolve()
excluded = {
    (root / "runtime" / "backups").resolve(),
    (root / "out").resolve(),
}

stack = [root]
while stack:
    current = stack.pop().resolve()
    if current in excluded:
        continue
    if not os.access(current, os.R_OK | os.X_OK):
        sys.exit(0)
    try:
        entries = list(os.scandir(current))
    except OSError:
        sys.exit(0)
    for entry in entries:
        path = Path(entry.path).resolve()
        if path in excluded:
            continue
        try:
            is_dir = entry.is_dir(follow_symlinks=False)
            is_symlink = entry.is_symlink()
        except OSError:
            sys.exit(0)
        if is_symlink:
            # GNU tar archives the link itself by default; the target may be a
            # container-only absolute path that the host cannot read.
            continue
        if is_dir:
            if not os.access(path, os.R_OK | os.X_OK):
                sys.exit(0)
            stack.append(path)
        elif not os.access(path, os.R_OK):
            sys.exit(0)

sys.exit(1)
PY
}

ensure_public_ingress() {
  if [ "$PUBLIC_INGRESS" != "1" ]; then
    return 0
  fi

  # Reconcile the digest-pinned connector on every deploy attempt, including
  # when no application image changed. --no-deps guarantees this cannot
  # recreate the forum or Monika containers.
  compose up -d --no-deps cloudflared
}

pull_images() {
  # Runtime autodeploy tracks only the coordinated Monika/forum images.
  compose pull monika forum
}

update_needed() {
  local monika_current forum_current monika_target forum_target
  MONIKA_UPDATE_NEEDED=0
  FORUM_UPDATE_NEEDED=0
  monika_current="$(container_image_id monika)"
  forum_current="$(container_image_id forum)"
  monika_target="$(image_id "$MONIKA_IMAGE")"
  forum_target="$(image_id "$MONIKA_FORUM_IMAGE")"

  if [ -z "$monika_current" ] || [ -z "$monika_target" ] || [ "$monika_current" != "$monika_target" ]; then
    MONIKA_UPDATE_NEEDED=1
  fi
  if [ -z "$forum_current" ] || [ -z "$forum_target" ] || [ "$forum_current" != "$forum_target" ]; then
    FORUM_UPDATE_NEEDED=1
  fi

  if [ "$MONIKA_UPDATE_NEEDED" = "1" ] || [ "$FORUM_UPDATE_NEEDED" = "1" ]; then
    echo "image update detected: monika=$MONIKA_UPDATE_NEEDED forum=$FORUM_UPDATE_NEEDED"
    return 0
  fi
  echo "images already current; no deploy needed"
  return 1
}

create_backup() {
  local ts repo_parent repo_name tmp archive needs_sudo
  ts="$(date -u +%Y%m%dT%H%M%SZ)"
  repo_parent="$(cd "$ROOT/.." && pwd)"
  repo_name="$(basename "$ROOT")"

  resolve_tar_bin
  resolve_backup_compression

  mkdir -p "$BACKUP_DIR"
  chmod 700 "$BACKUP_DIR"
  archive="$BACKUP_DIR/monika-redeploy-$ts.$BACKUP_ARCHIVE_EXTENSION"
  tmp="$archive.tmp"

  needs_sudo=0
  if backup_needs_sudo; then
    needs_sudo=1
  fi

  echo "creating backup: $archive"
  rm -f "$tmp"
  if [ "$needs_sudo" = "1" ]; then
    echo "backup contains files not readable by $(id -un); using non-interactive sudo for archive read"
    run_as_backup_reader "$TAR_BIN" \
      --exclude="$repo_name/runtime/backups" \
      --exclude="$repo_name/out" \
      -I "$BACKUP_COMPRESSOR" \
      -cf "$tmp" \
      -C "$repo_parent" \
      "$repo_name"
    run_as_backup_reader chown "$(id -u):$(id -g)" "$tmp"
  else
    "$TAR_BIN" \
      --exclude="$repo_name/runtime/backups" \
      --exclude="$repo_name/out" \
      -I "$BACKUP_COMPRESSOR" \
      -cf "$tmp" \
      -C "$repo_parent" \
      "$repo_name"
  fi
  verify_backup_compression "$tmp"
  "$TAR_BIN" -tf "$tmp" >/dev/null
  mv "$tmp" "$archive"
  chmod 600 "$archive"
  echo "backup complete: $archive"
}

prune_backups() {
  mkdir -p "$BACKUP_DIR"
  python3 - "$BACKUP_DIR" <<'PY'
from __future__ import annotations

import datetime as dt
import os
import sys
from pathlib import Path

backup_dir = Path(sys.argv[1])
files = sorted(
    [p for pattern in ("monika-redeploy-*.tar.zst", "monika-redeploy-*.tar.gz") for p in backup_dir.glob(pattern) if p.is_file()],
    key=lambda p: p.stat().st_mtime,
    reverse=True,
)
if not files:
    sys.exit(0)

now = dt.datetime.now(dt.timezone.utc)
today = now.date()
yesterday = today - dt.timedelta(days=1)
seven_days_ago = now - dt.timedelta(days=7)

def mtime(p: Path) -> dt.datetime:
    return dt.datetime.fromtimestamp(p.stat().st_mtime, dt.timezone.utc)

keep: set[Path] = set()
keep.update(files[:1])  # Always retain at least one backup.

current_day = [p for p in files if mtime(p).date() == today]
keep.update(current_day[:2])

previous_day = [p for p in files if mtime(p).date() == yesterday]
if previous_day:
    keep.add(previous_day[0])
else:
    previous_bucket = [p for p in files if today > mtime(p).date() and mtime(p) >= now - dt.timedelta(hours=48)]
    if previous_bucket:
        keep.add(previous_bucket[0])

weekly_bucket = [p for p in files if mtime(p) >= seven_days_ago and mtime(p).date() not in {today, yesterday}]
if weekly_bucket:
    keep.add(weekly_bucket[0])

for path in files:
    if path not in keep:
        print(f"pruning backup: {path}")
        path.unlink()
PY
}

prune_docker_images() {
  docker image prune -f --filter "until=$DOCKER_PRUNE_UNTIL"
}

cd "$ROOT"
require_git_current

if [ "$MODE" = "deploy" ]; then
  configure_image_selection
  ensure_public_ingress
  if [ "$RELEASE_CHANNEL" = "stable" ] && [ "$EXPLICIT_IMAGE_OVERRIDES" != "1" ]; then
    resolve_stable_release
  fi
  pull_images
  if [ "$RELEASE_CHANNEL" = "stable" ] && [ "$EXPLICIT_IMAGE_OVERRIDES" != "1" ]; then
    stable_revision_guards
  fi
  if ! update_needed; then
    # A prior replacement can have installed both target image IDs and then
    # failed its readiness gate. Do not turn the next retry into false success.
    wait_for_forum_ready_after_deploy
    exit 0
  fi
fi

acquire_forum_admission
if [ "$MODE" = "backup-only" ] || [ "$MONIKA_UPDATE_NEEDED" = "1" ]; then
  drain_agentd
fi
create_backup

if [ "$MODE" = "backup-only" ]; then
  prune_backups
  cancel_forum_admission
  echo "backup-only mode complete"
  exit 0
fi

# A long backup or an external drain cancel could reopen the race window. If the
# monika container is going to be recreated, renew the agentd drain immediately
# before Docker receives control.
if [ "$MONIKA_UPDATE_NEEDED" = "1" ]; then
  drain_agentd
fi

# Revalidate ownership and renew the process-local lease after backup/drain,
# immediately before Compose receives control. Failure is closed: an expired or
# replaced lease owner cannot proceed to container replacement.
acquire_forum_admission

if [ "$MONIKA_UPDATE_NEEDED" = "1" ]; then
  # Replace Monika independently. A replacement restores the durable drain and
  # cannot satisfy its healthy-only Compose contract until this process regains
  # control, cancels that drain, and proves the new agentd healthy/undrained.
  compose up -d --no-deps monika
  wait_for_agentd_drain_cancel_after_deploy
fi

if [ "$FORUM_UPDATE_NEEDED" = "1" ]; then
  if [ "$MONIKA_UPDATE_NEEDED" = "1" ]; then
    # The forum admission lease belongs to the still-running old forum process.
    # Renew it after Monika startup before the second replacement boundary.
    acquire_forum_admission
  fi
  # --no-deps is the safety boundary: a forum-only update cannot recreate
  # Monika because of unrelated Compose configuration drift. For a joint update,
  # agentd was already proved healthy above before Forum is replaced.
  compose up -d --no-deps forum
fi

wait_for_forum_ready_after_deploy
cancel_forum_admission
compose ps "${STATUS_SERVICES[@]}"
prune_backups
prune_docker_images
