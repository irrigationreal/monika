#!/usr/bin/env bash
set -euo pipefail

# Pull and apply the Monika + forum images only when the runtime reports that
# stopping containers is safe. Exit 75 (EX_TEMPFAIL) when a deploy should be
# retried later rather than forced.
#
# By default, this script only drains/backs up/recreates containers when a pull
# changes the target image ID for at least one managed service. Use
# --backup-only to create a quiescence-gated backup without deploying.

MODE="deploy"
if [ "${1:-}" = "--backup-only" ]; then
  MODE="backup-only"
  shift
fi
if [ "$#" -ne 0 ]; then
  echo "usage: $0 [--backup-only]" >&2
  exit 64
fi

ROOT="${MONIKA_DEPLOY_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
COMPOSE_FILE="${MONIKA_DEPLOY_COMPOSE_FILE:-$ROOT/compose.yaml}"
AGENTD_URL="${MONIKA_AGENTD_BASE_URL:-http://127.0.0.1:7724}"
FORUM_URL="${MONIKA_FORUM_BASE_URL:-http://127.0.0.1:4310/api}"
AGENTD_DRAIN_TIMEOUT_MS="${MONIKA_AGENTD_DRAIN_TIMEOUT_MS:-0}"
BACKUP_DIR="${MONIKA_DEPLOY_BACKUP_DIR:-$ROOT/runtime/backups/redeploy}"
BACKUP_COMPRESSION="${MONIKA_DEPLOY_BACKUP_COMPRESSION:-auto}"
BACKUP_ZSTD_LEVEL="${MONIKA_DEPLOY_BACKUP_ZSTD_LEVEL:-3}"
BACKUP_GZIP_LEVEL="${MONIKA_DEPLOY_BACKUP_GZIP_LEVEL:-6}"
DOCKER_PRUNE_UNTIL="${MONIKA_DEPLOY_DOCKER_PRUNE_UNTIL:-168h}"
REQUIRE_GIT_CURRENT="${MONIKA_DEPLOY_REQUIRE_GIT_CURRENT:-1}"
SUDO_BIN="${MONIKA_DEPLOY_SUDO_BIN:-/run/wrappers/bin/sudo}"
TAR_BIN="${MONIKA_DEPLOY_TAR_BIN:-}"
BACKUP_COMPRESSOR=""
BACKUP_COMPRESSION_RESOLVED=""
BACKUP_ARCHIVE_EXTENSION=""

export MONIKA_IMAGE="${MONIKA_IMAGE:-ghcr.io/irrigationreal/monika:main}"
export MONIKA_FORUM_IMAGE="${MONIKA_FORUM_IMAGE:-ghcr.io/irrigationreal/monika-forum:main}"

DRAIN_STARTED=0
CANCEL_DRAIN_ON_EXIT=0

json_field() {
  python3 -c 'import json,sys; data=json.load(sys.stdin); expr=sys.argv[1].split("."); v=data
for part in expr:
    v = v.get(part) if isinstance(v, dict) else None
print("true" if v is True else "false" if v is False else "" if v is None else v)' "$1"
}

tempfail() {
  echo "deploy deferred: $*" >&2
  exit 75
}

cancel_agentd_drain() {
  if [ "$DRAIN_STARTED" = "1" ] && [ "$CANCEL_DRAIN_ON_EXIT" = "1" ]; then
    curl -fsS -X POST "$AGENTD_URL/v1/admin/drain/cancel" >/dev/null 2>&1 || true
  fi
}
trap cancel_agentd_drain EXIT

require_safe_forum() {
  local state safe
  state="$(curl -fsS "$FORUM_URL/deploy/quiescence")" || tempfail "forum quiescence endpoint unavailable"
  safe="$(printf '%s' "$state" | json_field safeToStop)"
  [ "$safe" = "true" ] || tempfail "forum is not safe to stop: $state"
}

drain_agentd() {
  local state status safe
  state="$(curl -fsS "$AGENTD_URL/v1/admin/quiescence")" || tempfail "agentd quiescence endpoint unavailable"
  status="$(printf '%s' "$state" | json_field status)"
  if [ "$status" = "blocked" ]; then
    tempfail "agentd is blocked: $state"
  fi
  if [ "$status" != "safe_to_stop" ]; then
    state="$(curl -fsS -X POST "$AGENTD_URL/v1/admin/drain" \
      -H 'content-type: application/json' \
      --data "{\"timeout_ms\":${AGENTD_DRAIN_TIMEOUT_MS}}")" || tempfail "agentd drain failed"
    DRAIN_STARTED=1
    CANCEL_DRAIN_ON_EXIT=1
  fi
  safe="$(printf '%s' "$state" | json_field ok)"
  [ "$safe" = "true" ] || tempfail "agentd is not safe to stop after drain: $state"
}

require_git_current() {
  if [ "$REQUIRE_GIT_CURRENT" != "1" ]; then
    return 0
  fi
  if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    tempfail "deploy root is not a git worktree"
  fi

  local branch upstream_remote upstream_ref behind
  branch="$(git symbolic-ref --quiet --short HEAD 2>/dev/null)" || tempfail "live checkout is detached or has no branch"
  upstream_remote="$(git config "branch.$branch.remote" || true)"
  [ -n "$upstream_remote" ] || tempfail "live checkout branch $branch has no upstream remote"
  upstream_ref="$(git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null)" || tempfail "live checkout branch $branch has no upstream"

  git fetch --quiet "$upstream_remote" || tempfail "could not fetch git state from $upstream_remote"
  git diff --quiet --ignore-submodules -- || tempfail "live checkout has unstaged tracked changes"
  git diff --cached --quiet --ignore-submodules -- || tempfail "live checkout has staged changes"
  behind="$(git rev-list --count "HEAD..$upstream_ref")"
  [ "$behind" = "0" ] || tempfail "live checkout is behind $upstream_ref by $behind commits; pull/reconcile before deploying images"
}

container_image_id() {
  local service="$1" cid
  cid="$(docker compose -f "$COMPOSE_FILE" ps -q "$service" 2>/dev/null || true)"
  if [ -z "$cid" ]; then
    return 0
  fi
  docker inspect -f '{{.Image}}' "$cid"
}

image_id() {
  local image="$1"
  docker image inspect -f '{{.Id}}' "$image" 2>/dev/null || true
}

run_as_backup_reader() {
  if [ "$(id -u)" = "0" ]; then
    "$@"
  elif [ -x "$SUDO_BIN" ]; then
    "$SUDO_BIN" -n env PATH="$PATH" "$@"
  else
    sudo -n env PATH="$PATH" "$@"
  fi
}

is_gnu_tar() {
  "$1" --version 2>/dev/null | grep -q 'GNU tar'
}

resolve_tar_bin() {
  if [ -n "$TAR_BIN" ]; then
    if ! command -v "$TAR_BIN" >/dev/null 2>&1; then
      echo "configured MONIKA_DEPLOY_TAR_BIN is not executable: $TAR_BIN" >&2
      exit 69
    fi
    TAR_BIN="$(command -v "$TAR_BIN")"
    if ! is_gnu_tar "$TAR_BIN"; then
      echo "configured MONIKA_DEPLOY_TAR_BIN is not GNU tar: $TAR_BIN" >&2
      exit 69
    fi
    return 0
  fi

  if command -v tar >/dev/null 2>&1 && is_gnu_tar tar; then
    TAR_BIN="$(command -v tar)"
    return 0
  fi
  if command -v gtar >/dev/null 2>&1 && is_gnu_tar gtar; then
    TAR_BIN="$(command -v gtar)"
    return 0
  fi

  echo "GNU tar is required for redeploy backups." >&2
  echo "Install it on macOS with: brew install gnu-tar zstd" >&2
  echo "Or set MONIKA_DEPLOY_TAR_BIN to a GNU tar executable." >&2
  exit 69
}

require_command() {
  local command_name="$1"
  local install_hint="$2"
  if ! command -v "$command_name" >/dev/null 2>&1; then
    echo "$command_name is required for redeploy backups." >&2
    echo "$install_hint" >&2
    exit 69
  fi
}

resolve_backup_compression() {
  case "$BACKUP_COMPRESSION" in
    auto)
      if command -v zstd >/dev/null 2>&1; then
        BACKUP_COMPRESSION_RESOLVED="zstd"
      else
        BACKUP_COMPRESSION_RESOLVED="gzip"
      fi
      ;;
    zstd|gzip)
      BACKUP_COMPRESSION_RESOLVED="$BACKUP_COMPRESSION"
      ;;
    *)
      echo "unsupported MONIKA_DEPLOY_BACKUP_COMPRESSION: $BACKUP_COMPRESSION" >&2
      echo "Supported values: auto, zstd, gzip" >&2
      exit 64
      ;;
  esac

  case "$BACKUP_COMPRESSION_RESOLVED" in
    zstd)
      require_command zstd "Install it on macOS with: brew install zstd"
      BACKUP_COMPRESSOR="zstd -T0 -$BACKUP_ZSTD_LEVEL"
      BACKUP_ARCHIVE_EXTENSION="tar.zst"
      ;;
    gzip)
      require_command gzip "gzip is normally available by default; install gzip or set MONIKA_DEPLOY_BACKUP_COMPRESSION=zstd."
      BACKUP_COMPRESSOR="gzip -n -$BACKUP_GZIP_LEVEL"
      BACKUP_ARCHIVE_EXTENSION="tar.gz"
      ;;
  esac
}

verify_backup_compression() {
  case "$BACKUP_COMPRESSION_RESOLVED" in
    zstd) zstd -t "$1" >/dev/null ;;
    gzip) gzip -t "$1" >/dev/null ;;
  esac
}

backup_needs_sudo() {
  if [ "$(id -u)" = "0" ]; then
    return 1
  fi

  python3 - "$ROOT" <<'PY'
import os
import sys
from pathlib import Path

root = Path(sys.argv[1]).resolve()
excluded = {
    (root / "runtime" / "backups").resolve(),
    (root / "out").resolve(),
}

stack = [root]
while stack:
    current = stack.pop().resolve()
    if current in excluded:
        continue
    if not os.access(current, os.R_OK | os.X_OK):
        sys.exit(0)
    try:
        entries = list(os.scandir(current))
    except OSError:
        sys.exit(0)
    for entry in entries:
        path = Path(entry.path).resolve()
        if path in excluded:
            continue
        try:
            is_dir = entry.is_dir(follow_symlinks=False)
        except OSError:
            sys.exit(0)
        if is_dir:
            if not os.access(path, os.R_OK | os.X_OK):
                sys.exit(0)
            stack.append(path)
        elif not os.access(path, os.R_OK):
            sys.exit(0)

sys.exit(1)
PY
}

pull_images() {
  docker compose -f "$COMPOSE_FILE" pull monika forum
}

update_needed() {
  local monika_current forum_current monika_target forum_target
  monika_current="$(container_image_id monika)"
  forum_current="$(container_image_id forum)"
  monika_target="$(image_id "$MONIKA_IMAGE")"
  forum_target="$(image_id "$MONIKA_FORUM_IMAGE")"

  if [ -z "$monika_current" ] || [ -z "$forum_current" ]; then
    echo "container missing; deploy needed"
    return 0
  fi
  if [ -z "$monika_target" ] || [ -z "$forum_target" ]; then
    echo "target image missing after pull; deploy needed"
    return 0
  fi
  if [ "$monika_current" != "$monika_target" ] || [ "$forum_current" != "$forum_target" ]; then
    echo "image update detected"
    return 0
  fi
  echo "images already current; no deploy needed"
  return 1
}

create_backup() {
  local ts repo_parent repo_name tmp archive needs_sudo
  ts="$(date -u +%Y%m%dT%H%M%SZ)"
  repo_parent="$(cd "$ROOT/.." && pwd)"
  repo_name="$(basename "$ROOT")"

  resolve_tar_bin
  resolve_backup_compression

  mkdir -p "$BACKUP_DIR"
  chmod 700 "$BACKUP_DIR"
  archive="$BACKUP_DIR/monika-redeploy-$ts.$BACKUP_ARCHIVE_EXTENSION"
  tmp="$archive.tmp"

  needs_sudo=0
  if backup_needs_sudo; then
    needs_sudo=1
  fi

  echo "creating backup: $archive"
  rm -f "$tmp"
  if [ "$needs_sudo" = "1" ]; then
    echo "backup contains files not readable by $(id -un); using non-interactive sudo for archive read"
    run_as_backup_reader "$TAR_BIN" \
      --exclude="$repo_name/runtime/backups" \
      --exclude="$repo_name/out" \
      -I "$BACKUP_COMPRESSOR" \
      -cf "$tmp" \
      -C "$repo_parent" \
      "$repo_name"
    run_as_backup_reader chown "$(id -u):$(id -g)" "$tmp"
  else
    "$TAR_BIN" \
      --exclude="$repo_name/runtime/backups" \
      --exclude="$repo_name/out" \
      -I "$BACKUP_COMPRESSOR" \
      -cf "$tmp" \
      -C "$repo_parent" \
      "$repo_name"
  fi
  verify_backup_compression "$tmp"
  "$TAR_BIN" -tf "$tmp" >/dev/null
  mv "$tmp" "$archive"
  chmod 600 "$archive"
  echo "backup complete: $archive"
}

prune_backups() {
  mkdir -p "$BACKUP_DIR"
  python3 - "$BACKUP_DIR" <<'PY'
from __future__ import annotations

import datetime as dt
import os
import sys
from pathlib import Path

backup_dir = Path(sys.argv[1])
files = sorted(
    [p for pattern in ("monika-redeploy-*.tar.zst", "monika-redeploy-*.tar.gz") for p in backup_dir.glob(pattern) if p.is_file()],
    key=lambda p: p.stat().st_mtime,
    reverse=True,
)
if not files:
    sys.exit(0)

now = dt.datetime.now(dt.timezone.utc)
today = now.date()
yesterday = today - dt.timedelta(days=1)
seven_days_ago = now - dt.timedelta(days=7)

def mtime(p: Path) -> dt.datetime:
    return dt.datetime.fromtimestamp(p.stat().st_mtime, dt.timezone.utc)

keep: set[Path] = set()
keep.update(files[:1])  # Always retain at least one backup.

current_day = [p for p in files if mtime(p).date() == today]
keep.update(current_day[:2])

previous_day = [p for p in files if mtime(p).date() == yesterday]
if previous_day:
    keep.add(previous_day[0])
else:
    previous_bucket = [p for p in files if today > mtime(p).date() and mtime(p) >= now - dt.timedelta(hours=48)]
    if previous_bucket:
        keep.add(previous_bucket[0])

weekly_bucket = [p for p in files if mtime(p) >= seven_days_ago and mtime(p).date() not in {today, yesterday}]
if weekly_bucket:
    keep.add(weekly_bucket[0])

for path in files:
    if path not in keep:
        print(f"pruning backup: {path}")
        path.unlink()
PY
}

prune_docker_images() {
  docker image prune -f --filter "until=$DOCKER_PRUNE_UNTIL"
}

cd "$ROOT"
require_git_current

if [ "$MODE" = "deploy" ]; then
  pull_images
  if ! update_needed; then
    exit 0
  fi
fi

require_safe_forum
drain_agentd
create_backup

if [ "$MODE" = "backup-only" ]; then
  prune_backups
  echo "backup-only mode complete"
  exit 0
fi

# From here onward the containers are expected to restart, so do not cancel the
# agentd drain state on exit.
CANCEL_DRAIN_ON_EXIT=0

docker compose -f "$COMPOSE_FILE" up -d --remove-orphans monika forum
docker compose -f "$COMPOSE_FILE" ps monika forum
prune_backups
prune_docker_images
