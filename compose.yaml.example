# Canonical standalone-persistent Monika deployment.
#
# Copy this file to compose.yaml and keep local edits out of git:
#   cp compose.yaml.example compose.yaml
#   docker compose up -d --build
#
# The container owns Pi, extensions, memstore, agentd, and the forum runtime.
# Mutable/private state lives in ./runtime. Host access is explicit through SSH
# / relocate, not automatic host-mode shell execution.

name: monika

services:
  monika:
    image: ${MONIKA_IMAGE:-ghcr.io/irrigationreal/monika:main}
    build:
      context: .
      dockerfile: Containerfile
    container_name: monika
    restart: unless-stopped
    stop_grace_period: 10m
    healthcheck:
      test: ["CMD-SHELL", "test -S \"$${MEMSTORE_SOCKET:-/tmp/memstore.sock}\" && curl -fsS \"http://127.0.0.1:7724/healthz\" | grep -q '\"status\":\"healthy\"'"]
      interval: 10s
      timeout: 3s
      retries: 3
      start_period: 20s
    extra_hosts:
      - "host.docker.internal:host-gateway"
    ports:
      # Host-side deployment automation uses agentd's quiescence/drain APIs.
      # Bind to loopback only; agentd is not a public HTTP service.
      - "127.0.0.1:${MONIKA_AGENTD_PORT:-7724}:7724"
    volumes:
      - ./runtime/data:/data
      - ./runtime/persona:/app/.pi/stateful-memory
      - ./runtime/pi-agent/sessions:/app/.pi/agent/sessions
      - ./runtime/pi-agent/skills:/app/.pi/agent/skills
      - ./runtime/forum/uploads:/forum/uploads:ro
      - ./runtime/import:/import:ro
      - ./runtime/agentlogs-home:/agentlogs-home
      - ./runtime/secrets:/runtime/secrets:ro
      - ./runtime/secrets/ssh:/root/.ssh:ro
      - ./runtime/secrets/ssh:/app/.ssh:ro
      - ${MONIKA_WORKSPACE:-/home/monika/repos}:/workspace
    working_dir: /workspace/monika
    env_file:
      - path: ./runtime/secrets/secrets.env
        required: false
      # Shares CODEX_FORUM_INTERNAL_API_TOKEN with the forum so Pi can upload
      # generated files through the internal pending-attachment endpoint.
      - path: ./runtime/secrets/forum.env
        required: false
    environment:
      HOME: /app
      PI_CODING_AGENT_DIR: /app/.pi/agent
      PI_OFFLINE: "1"
      PI_SUBAGENT_EXECUTION_TARGET_ROOT: /runtime/secrets/ssh/targets
      PI_SUBAGENT_SSH_LOCK_EXTENSION: /app/.pi/agent/extensions/ssh.ts
      MONIKA_SSH_LOCK_DESCRIPTOR: ${MONIKA_SSH_LOCK_DESCRIPTOR:-}
      MEMSTORE_SOCKET: /tmp/memstore.sock
      GNUPGHOME: /tmp/gnupg
      MONIKA_WORKSPACE: /workspace
      AGENTLOGS_HOME: /agentlogs-home
      MONIKA_AGENTD_HOST: 0.0.0.0
      # Compose keeps the service port fixed; MONIKA_AGENTD_PORT above is only
      # the host-side loopback publication override.
      MONIKA_AGENTD_PORT: "7724"
      MONIKA_AGENTD_DRAIN_STATE_FILE: ${MONIKA_AGENTD_DRAIN_STATE_FILE:-/data/agentd-drain-state.json}
      MONIKA_AGENTD_DEFAULT_CWD: ${MONIKA_AGENTD_DEFAULT_CWD:-/workspace/monika}
      MONIKA_AGENTD_MODEL_REFRESH_MS: ${MONIKA_AGENTD_MODEL_REFRESH_MS:-14400000}
      MONIKA_AGENTD_ATTACHMENT_ALLOWED_ROOTS: /forum/uploads
      MONIKA_AGENTD_ARTIFACT_ALLOWED_ROOTS: /workspace:/tmp:/data
      MONIKA_FORUM_API_BASE_URL: http://forum:4310/api
      GIT_USER_NAME: ${GIT_USER_NAME:-Monika}
      GIT_USER_EMAIL: ${GIT_USER_EMAIL:-monika@neosynth.net}
      POOL_CONFIG_URL: ${POOL_CONFIG_URL:-}
    networks:
      - backend

  cloudflared:
    image: ${MONIKA_CLOUDFLARED_IMAGE:-cloudflare/cloudflared@sha256:e39ee8da81ad5e05d77f38d2f51c60ca51bf2a8450ac3abab50c17fdb91d91bf}
    profiles: ["public-ingress"]
    restart: unless-stopped
    user: "65532:65532"
    read_only: true
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    command: ["tunnel", "run", "--token-file", "/run/secrets/cloudflared-token"]
    volumes:
      # Keep the connector credential outside MONIKA_WORKSPACE: the entire
      # repository parent is mounted into the agent-capable application.
      - ${MONIKA_CLOUDFLARED_TOKEN_FILE:-/persist/keys/cloudflared-vmonika.token}:/run/secrets/cloudflared-token:ro
    networks:
      - ingress
    depends_on:
      forum:
        condition: service_healthy

  forum:
    image: ${MONIKA_FORUM_IMAGE:-ghcr.io/irrigationreal/monika-forum:main}
    build:
      context: ./services/forum
      dockerfile: Containerfile
    container_name: monika-forum
    restart: unless-stopped
    stop_grace_period: 10m
    healthcheck:
      test: ["CMD", "node", "-e", "fetch('http://127.0.0.1:4310/readyz').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"]
      interval: 10s
      timeout: 3s
      retries: 3
      start_period: 20s
    user: "0:0"
    depends_on:
      monika:
        condition: service_healthy
    ports:
      # Public traffic should arrive through the private Docker network via a
      # trusted tunnel/proxy. Keep host-side health and deploy APIs on loopback.
      - "${MONIKA_FORUM_BIND:-127.0.0.1:4310:4310}"
    volumes:
      - ./runtime/forum:/forum
      - ${MONIKA_WORKSPACE:-/home/monika/repos}:/workspace
    env_file:
      # Must include CODEX_FORUM_INTERNAL_API_TOKEN for internal Monika/forum
      # pending-attachment uploads and CODEX_FORUM_DEPLOY_TOKEN for host-side
      # deploy quiescence checks. Generate separate random values for each.
      - path: ./runtime/secrets/forum.env
        required: false
    environment:
      NODE_ENV: production
      CODEX_FORUM_PORT: "4310"
      CODEX_FORUM_DB: /forum/data.db
      CODEX_FORUM_UPLOADS_DIR: /forum/uploads
      CODEX_FORUM_BASE_URL: ${CODEX_FORUM_BASE_URL:-http://localhost:4310}
      CODEX_FORUM_PASSWORD_LOGIN_ENABLED: ${CODEX_FORUM_PASSWORD_LOGIN_ENABLED:-1}
      CODEX_FORUM_WEBAUTHN_RP_ID: ${CODEX_FORUM_WEBAUTHN_RP_ID:-}
      CODEX_FORUM_WEBAUTHN_RP_NAME: ${CODEX_FORUM_WEBAUTHN_RP_NAME:-Monika Forum}
      CODEX_FORUM_API_BASE_URL: http://forum:4310
      CODEX_FORUM_API_PREFIX: /api
      CODEX_FORUM_AGENT_BACKEND: monika-pi
      CODEX_FORUM_AGENT_MODEL: ${CODEX_FORUM_AGENT_MODEL:-codex/gpt-5.6-sol}
      MONIKA_AGENTD_BASE_URL: http://monika:7724
      MONIKA_PI_SESSION_TAXONOMY_CONFIG: ${MONIKA_PI_SESSION_TAXONOMY_CONFIG:-}
      MONIKA_FORUM_DEFAULT_CWD: ${MONIKA_FORUM_DEFAULT_CWD:-/workspace}
      CODEX_WORK_DIR: ${CODEX_WORK_DIR:-/workspace}
      CODEX_FORUM_ENABLE_AUTH: "1"
      CODEX_FORUM_REGISTRATION_MODE: ${CODEX_FORUM_REGISTRATION_MODE:-disabled}
      CODEX_FORUM_ENABLE_RATE_LIMITING: ${CODEX_FORUM_ENABLE_RATE_LIMITING:-0}
      CODEX_FORUM_TRUST_PROXY: ${CODEX_FORUM_TRUST_PROXY:-0}
      CODEX_FORUM_REDIS_STREAM_BUS: "0"
    networks:
      - backend
      - ingress

networks:
  backend:
  ingress:
