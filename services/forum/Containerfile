# =============================================================================
# Codex Forum - Multi-stage Docker Build
# =============================================================================

# -----------------------------------------------------------------------------
# Stage 1: Base image with pnpm
# -----------------------------------------------------------------------------
ARG MONIKA_BUILD_COMMIT=""
ARG MONIKA_BUILD_SOURCE=""
ARG MONIKA_BUILD_DATE=""

FROM node:20-slim AS base

# Install pnpm
RUN corepack enable && corepack prepare pnpm@10.26.2 --activate

# Install build dependencies for native modules (better-sqlite3)
RUN apt-get update && apt-get install -y \
    python3 \
    make \
    g++ \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy workspace configuration
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

# Copy all package.json files to enable pnpm to resolve workspace dependencies
COPY packages/typescript-config/package.json ./packages/typescript-config/
COPY packages/eslint-config/package.json ./packages/eslint-config/
COPY packages/contracts/package.json ./packages/contracts/
COPY packages/core/package.json ./packages/core/
COPY packages/adapters/package.json ./packages/adapters/
COPY packages/server/package.json ./packages/server/
COPY packages/cli/package.json ./packages/cli/
COPY packages/forum-sdk/package.json ./packages/forum-sdk/
COPY apps/codex-forum/package.json ./apps/codex-forum/

# Install all dependencies
RUN pnpm install --frozen-lockfile

# -----------------------------------------------------------------------------
# Stage 2: Build packages
# -----------------------------------------------------------------------------
FROM base AS builder

ARG MONIKA_BUILD_COMMIT
ARG MONIKA_BUILD_SOURCE
ARG MONIKA_BUILD_DATE

# Copy source files
COPY packages/ ./packages/
COPY apps/ ./apps/
COPY tsconfig.json ./

# Build packages first (dependencies for apps)
RUN pnpm run build:packages

# Build metadata is baked into the image and frontend bundle. CI passes these
# as Docker build args; local builds fall back to an explicit local label.
RUN MONIKA_BUILD_COMMIT="$MONIKA_BUILD_COMMIT" \
    MONIKA_BUILD_SOURCE="$MONIKA_BUILD_SOURCE" \
    MONIKA_BUILD_DATE="$MONIKA_BUILD_DATE" \
    node -e "const fs=require('fs'); const info={commit:process.env.MONIKA_BUILD_COMMIT||null,source:process.env.MONIKA_BUILD_SOURCE||null,date:process.env.MONIKA_BUILD_DATE||null,label:process.env.MONIKA_BUILD_COMMIT?process.env.MONIKA_BUILD_COMMIT.slice(0,12):'local build'}; fs.writeFileSync('/app/build-info.json', JSON.stringify(info,null,2)+'\\n');"

# Build frontend application
RUN VITE_BUILD_COMMIT="$MONIKA_BUILD_COMMIT" \
    VITE_BUILD_SOURCE="$MONIKA_BUILD_SOURCE" \
    VITE_BUILD_DATE="$MONIKA_BUILD_DATE" \
    pnpm run build:apps

# Deploy the server package with only production dependencies.
# pnpm deploy creates a standalone directory with the package, its workspace
# dependencies (copied into node_modules), and only production npm packages.
# Native modules (better-sqlite3, sharp) are deployed from the builder where
# their install scripts have already run; the runtime needs no build toolchain.
RUN pnpm --filter @irrigationreal/codex-forum-server deploy --prod --legacy /app/deploy

# -----------------------------------------------------------------------------
# Stage 3: Production runtime
# -----------------------------------------------------------------------------
FROM node:20-slim AS runtime

ARG MONIKA_BUILD_COMMIT
ARG MONIKA_BUILD_SOURCE
ARG MONIKA_BUILD_DATE

LABEL org.opencontainers.image.revision=$MONIKA_BUILD_COMMIT
LABEL org.opencontainers.image.source=$MONIKA_BUILD_SOURCE
LABEL org.opencontainers.image.created=$MONIKA_BUILD_DATE

# Create non-root user for security
RUN groupadd --gid 1001 codex && \
    useradd --uid 1001 --gid 1001 -m codex

WORKDIR /app

# Copy the pnpm-deployed server with production-only dependencies.
# This includes workspace packages (core, contracts, adapters) in node_modules
# and all native modules pre-built from the builder stage.
COPY --from=builder /app/deploy/ ./

# Copy baked build metadata and built frontend to be served as static files
COPY --from=builder /app/build-info.json ./build-info.json
COPY --from=builder /app/apps/codex-forum/dist/ ./public/

# Create data directories with proper ownership
RUN mkdir -p /var/lib/codex-forum/uploads && \
    chown -R codex:codex /var/lib/codex-forum && \
    chown -R codex:codex /app

# Switch to non-root user
USER codex

# Environment variables with defaults
ENV NODE_ENV=production
ENV CODEX_FORUM_PORT=4310
ENV CODEX_FORUM_DB=/var/lib/codex-forum/data.db
ENV CODEX_FORUM_UPLOADS_DIR=/var/lib/codex-forum/uploads
ENV CODEX_FORUM_BASE_URL=http://localhost:4310
ENV CODEX_FORUM_PUBLIC_DIR=/app/public

# Expose the server port
EXPOSE 4310

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD node -e "fetch('http://localhost:4310/healthz').then(r => r.ok ? process.exit(0) : process.exit(1)).catch(() => process.exit(1))"

# Start the server using tsx from the deployed package
CMD ["node_modules/.bin/tsx", "src/server.ts"]
