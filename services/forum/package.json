{
  "name": "@irrigationreal/codex-forum",
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "description": "codex-forum monorepo",
  "packageManager": "pnpm@10.26.2",
  "dependencies": {
    "zod": "^3.25.76"
  },
  "scripts": {
    "build": "pnpm -r --filter='./packages/*' build && pnpm -r --filter='./apps/*' build",
    "build:packages": "pnpm -r --filter='./packages/*' build",
    "build:apps": "pnpm -r --filter='./apps/*' build",
    "dev": "pnpm -r --filter='./apps/*' dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "test": "pnpm -r test",
    "test:watch": "pnpm -r --parallel test:watch",
    "test:coverage": "pnpm -r test:coverage",
    "generate:openapi": "tsx scripts/generate-openapi.ts",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "clean:install": "pnpm clean && pnpm install",
    "prepare": "husky",
    "guardrails:types": "node scripts/guardrails/check-duplicate-types.mjs",
    "ci:guardrails": "pnpm guardrails:types",
    "import:pi-sessions": "corepack pnpm --filter @irrigationreal/codex-forum-server import:pi-sessions --"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "@irrigationreal/eslint-config": "workspace:*",
    "@irrigationreal/typescript-config": "workspace:*",
    "@types/node": "^24.10.4",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "@typescript-eslint/utils": "^8.51.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.7.4",
    "tsx": "^4.20.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.51.0"
  },
  "lint-staged": {
    "*.{js,ts,tsx,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "@isaacs/brace-expansion": ">=5.0.1",
      "brace-expansion@1": "1.1.18",
      "brace-expansion@2": "2.1.4",
      "brace-expansion@5": "5.0.9",
      "fast-uri@3": "3.1.5",
      "fast-xml-parser": ">=5.3.4",
      "find-my-way@9": "9.7.0",
      "js-yaml@4": "4.3.1",
      "lodash": "4.18.1",
      "postcss@8": "8.5.23",
      "undici@6": "6.28.0"
    }
  }
}
