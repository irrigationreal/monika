# =============================================================================
# Codex Forum - Staging Systemd Service File
# =============================================================================
#
# Installation:
#   sudo cp scripts/codex-forum-staging.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable codex-forum-staging
#   sudo systemctl start codex-forum-staging
#
# Usage:
#   sudo systemctl status codex-forum-staging
#   sudo systemctl restart codex-forum-staging
#   sudo journalctl -u codex-forum-staging -f
#
# =============================================================================

[Unit]
Description=Codex Forum Server (Staging)
Documentation=https://github.com/your-org/codex-forum
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=codex
Group=codex

# Working directory (adjust to your installation path)
WorkingDirectory=/opt/codex-forum-staging/packages/server

# Environment
Environment=NODE_ENV=production
EnvironmentFile=/opt/codex-forum-staging/.env

# Start command
ExecStart=/usr/bin/pnpm start

# Restart configuration
Restart=always
RestartSec=10
StartLimitInterval=60
StartLimitBurst=3

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/codex-forum-staging /mnt/storage/forum-attachments-staging

# Resource limits (adjust as needed)
MemoryMax=2G
CPUQuota=200%

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=codex-forum-staging

[Install]
WantedBy=multi-user.target
