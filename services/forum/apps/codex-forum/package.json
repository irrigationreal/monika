{
  "name": "@irrigationreal/codex-forum",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "clean": "rm -rf dist node_modules .eslintcache coverage",
    "dev": "vite",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:ui": "playwright test --ui",
    "lint": "eslint \"src/**/*.{ts,tsx,vue}\" --cache --cache-location .eslintcache --cache-strategy content",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "vue-tsc -b"
  },
  "dependencies": {
    "@irrigationreal/codex-forum-contracts": "workspace:*",
    "@irrigationreal/codex-forum-sdk": "workspace:*",
    "highlight.js": "^11.11.1",
    "marked": "^17.0.1",
    "vue": "^3.5.26",
    "vue-router": "^4.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@irrigationreal/eslint-config": "workspace:*",
    "@irrigationreal/typescript-config": "workspace:*",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/user-event": "^14.6.1",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^24.10.4",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vitest/coverage-v8": "^4.0.16",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "happy-dom": "^20.0.11",
    "playwright": "^1.57.0",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.0.16",
    "vue-tsc": "^3.2.1"
  }
}
