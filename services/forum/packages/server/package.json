{
  "name": "@irrigationreal/codex-forum-server",
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf node_modules dist .eslintcache",
    "dev": "tsx src/server.ts",
    "start": "tsx src/server.ts",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "import:pi-sessions": "tsx src/cli/importPiSessions.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/sensible": "^6.0.4",
    "@fastify/static": "^10.1.2",
    "@irrigationreal/codex-forum-adapters": "workspace:*",
    "@irrigationreal/codex-forum-contracts": "workspace:*",
    "@irrigationreal/codex-forum-core": "workspace:*",
    "@simplewebauthn/server": "13.3.2",
    "better-sqlite3": "^11.6.0",
    "discord.js": "^14.16.3",
    "fastify": "^5.8.5",
    "nanoid": "^5.1.0",
    "nodemailer": "^9.0.3",
    "redis": "^5.10.0",
    "sharp": "^0.35.3",
    "tsx": "^4.20.3"
  },
  "devDependencies": {
    "@irrigationreal/typescript-config": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "@types/busboy": "^1.5.4",
    "@types/node": "^24.10.4",
    "@types/nodemailer": "^6.4.17",
    "@types/redis": "^4.0.11",
    "typescript": "~5.9.3",
    "vitest": "^4.1.0"
  }
}
