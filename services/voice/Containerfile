FROM node:22-bookworm-slim

LABEL org.opencontainers.image.licenses="AGPL-3.0-or-later"
ENV NODE_ENV=production \
    VOICE_HOST=0.0.0.0 \
    VOICE_PORT=4320 \
    VOICE_STATE_DIR=/data/voice

WORKDIR /opt/voice
COPY package.json ./
COPY src/ ./src/
COPY public/ ./public/
RUN mkdir -p /data/voice && chown -R node:node /data

USER node
VOLUME /data
EXPOSE 4320
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:4320/healthz').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["node", "src/server.mjs"]
